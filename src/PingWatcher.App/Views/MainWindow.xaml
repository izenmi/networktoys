<!-- 既定幅はタブが一列にぎりぎり収まるところまで詰めてある(自己診断が実測して
     786px と突き合わせている)。狭めたい人は縮められるよう MinWidth は据え置き -->
<Window x:Class="PingWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PingWatcher.App.Controls"
        xmlns:vm="clr-namespace:PingWatcher.App.ViewModels"
        xmlns:net="clr-namespace:PingWatcher.Core.Net;assembly=PingWatcher.Core"
        Title="PingWatcher"
        Width="880" Height="760"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Backdrop}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            一覧から次の道具へ送るメニュー。スキャン・接続・遮断・Meraki・syslog・Trap で
            使い回す。これまで橋が架かっていたのは Ping/TCP の一覧だけで、他のタブで
            見つけた IP は手で打ち直すしかなかった。

            x:Shared="False" を付けて、使う一覧ごとに別の実体を作らせる。
            1 つの実体を複数の要素で共有すると PlacementTarget が取り合いになる。

            アドレスの取り出しはコードビハインドの AddressOf に集約してあるので、
            ここは Click の名前を揃えるだけでよい。
        -->
        <ContextMenu x:Key="RowMenu.Device" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext,
                                   RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Ping の宛先に追加" Click="OnSendToPing" />
            <MenuItem Header="TCP Ping に追加" Click="OnSendToTcp" />
            <MenuItem Header="収集の機器に追加" Click="OnSendToCollect" />
            <Separator />
            <MenuItem Header="経路を調べる" Click="OnSendToTrace" />
            <MenuItem Header="名前を引く" Click="OnSendToDns" />
            <MenuItem Header="SNMP で問い合わせる" Click="OnSendToSnmp" />
            <Separator />
            <MenuItem Header="アドレスをコピー" Click="OnCopyRowAddress" />
        </ContextMenu>

        <!-- 通信の相手（接続・遮断・Meraki のクライアント）。機器として扱う項目は出さない -->
        <ContextMenu x:Key="RowMenu.Address" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext,
                                   RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Ping の宛先に追加" Click="OnSendToPing" />
            <Separator />
            <MenuItem Header="経路を調べる" Click="OnSendToTrace" />
            <MenuItem Header="名前を引く" Click="OnSendToDns" />
            <Separator />
            <MenuItem Header="アドレスをコピー" Click="OnCopyRowAddress" />
        </ContextMenu>

        <!--
            タブの中のサブタブ用（FTP タブの FTP/TFTP/SFTP など）。
            主タブと明確に見分けられるよう、小さめのセグメント（連結ボタン）風にする。
            選択中はアクセント地、非選択はくすませて「これは中の切り替え」と分かる形に。
        -->
        <Style x:Key="SubTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 文字は常に本文色（ダークではほぼ白）。選択中に淡い水色にすると沈んで読みづらい -->
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- 寸法はメインタブ(Padding 6,2・Size.Caption)と揃える -->
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Margin="0,0,-1,0"
                                Padding="6,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontSize="{DynamicResource Size.Caption}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            まとめたタブ（調べる / NW機器 / 受ける）の中身を選ぶ縦メニュー。

            サブタブの帯を横に並べると、7 本 8 本になったところで名前が読めなくなる。
            左に立てたメニューなら名前を省略せずに置け、いま何を開いているかも一目で分かる。
            中身は TabControl のまま（TabStripPlacement="Left"）なので、
            見えていないタブが動き出さない仕組み（MainWindow.IsShowing）はそのまま効く。
        -->
        <Style x:Key="MenuTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                Padding="9,4,12,4"
                                Margin="0,0,0,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.FontSize="{DynamicResource Size.Caption}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <!-- 選ばれている項目は、地色と左の縦棒の両方で示す（色だけに頼らない） -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            各タブの先頭に置く 1 行の説明と、その左の ⓘ。
            「何をする画面か」は開いた瞬間に分かる必要がある（タブ名だけでは足りない）。
            詳しい話は ⓘ にマウスを載せたときだけ出し、常時は 1 行に抑える。
        -->
        <Style x:Key="TabIntro" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabInfoMark" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <!-- すぐ出して、読み終わるまで消えないようにする -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="120000" />
        </Style>

        <!-- 値の表示欄。読み取り専用の TextBox にして、選択してコピーできるようにする -->
        <Style x:Key="CopyableValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!--
            Ping 一覧の列幅。以前は列見出しと行テンプレートの両方に同じ数字を
            書いていて、片方だけ直すとずれた。幅の出どころをここ 1 か所にする。

            StaticResource なのは、実行中に変わらない値だから。DynamicResource に
            すると仮想化された行を作り直すたびに解決が走る。前方参照はできないので、
            使う側より前に置くこと。
        -->
        <!-- 一覧 1 行。列幅は上の定義を見出しと共有している -->
        <DataTemplate x:Key="TargetRowTemplate">
            <Grid Height="{DynamicResource Size.RowHeight}">
                <!-- 幅はヘッダと共有(ColumnLayout)。ヘッダの境目をドラッグすると全行が追随する。
                     備考は宛先の右隣(ユーザー指示)の可変幅で、余った幅を吸収する。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target}" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark}" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge"
                        Grid.Column="0"
                        Style="{StaticResource Badge}"
                        Background="{DynamicResource Brush.Info.Bg}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText"
                               Style="{StaticResource Badge.Text}"
                               Foreground="{DynamicResource Brush.Info.Fg}"
                               Text="◌ 待機" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding HostDisplay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HostDisplay}" />

                <TextBlock Grid.Column="2" Text="{Binding Comment}"
                           Style="{StaticResource Caption}"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Comment}" />

                <TextBlock Grid.Column="3" Text="{Binding LatestRtt}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Column="4" Text="{Binding Loss}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <controls:Sparkline Grid.Column="5" Source="{Binding}" Margin="8,3,8,3"
                                    LineBrush="{DynamicResource Brush.Chart.Line}"
                                    LostBrush="{DynamicResource Brush.Error.Fg}" />

                <!-- 列の区切り線。行の区切り線と同じ淡さの縦線で、境目を目で追えるようにする -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="● 応答" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="✕ 不通" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Refused">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="⊘ 拒否" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unresolved">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="? 名前" />
                </DataTrigger>
                <!-- 測定が止まっている状態。不達と取り違えると確認ツールとして嘘になる -->
                <DataTrigger Binding="{Binding State}" Value="Stalled">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="… 停止" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            右クリックメニューを持たない行コンテナ。
            スキャン結果・周辺 AP・作業比較・差分比較の一覧はこちらを使う。
            メニュー付きのコンテナを流用すると、DataContext の型が違うため
            「経路を調べる」などを押しても無反応のメニューが出てしまう。
        -->
        <Style x:Key="PlainRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上の枠付き版。差分比較の一覧が使う（選択を枠で示す） -->
        <Style x:Key="PlainCompactContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Margin="0,0,3,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行コンテナ。選択の見た目だけ差し替え、既定の青い選択色は使わない -->
        <Style x:Key="TargetRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="TCP Ping に追加" Click="OnAddToTcpFromRow" />
                                    <Separator />
                                    <MenuItem Header="SSH で接続" Click="OnSshFromRow" />
                                    <MenuItem Header="Telnet で接続" Click="OnTelnetFromRow" />
                                    <Separator />
                                    <MenuItem Header="経路を調べる" Click="OnTraceFromRow" />
                                    <MenuItem Header="名前を引く" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="宛先名をコピー" Click="OnCopyHostFromRow" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            応答なし欄用の行コンテナ。選択はアクセントの緑ではなく赤系で示す。
            赤いカードの中で選択行だけ緑に光ると、状態が変わったように見えてしまう。
        -->
        <Style x:Key="DownRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="TCP Ping に追加" Click="OnAddToTcpFromRow" />
                                    <Separator />
                                    <MenuItem Header="SSH で接続" Click="OnSshFromRow" />
                                    <MenuItem Header="Telnet で接続" Click="OnTelnetFromRow" />
                                    <Separator />
                                    <MenuItem Header="経路を調べる" Click="OnTraceFromRow" />
                                    <MenuItem Header="名前を引く" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="宛先名をコピー" Click="OnCopyHostFromRow" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <!-- 面を一段持ち上げて示す(緑のアクセントは使わない) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            1 行 1 件の一覧（仮想化必須）。
            参照するテンプレートより後に置くこと（StaticResource は前方参照できない）。
        -->
        <!--
            機器を選ぶ札。タブと同じ見た目にして「押して切り替えるもの」と分かるようにする。
            選択中はアクセント色で塗り、貼り付け済みの数を添える。
        -->
        <Style x:Key="DeviceChip" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 寸法はメインタブ(Padding 6,2・Size.Caption・間隔 2)と揃える -->
            <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="6,2"
                                Margin="0,0,2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!--
                仮想化の指定は ListBox 側に付ける。VirtualizingStackPanel は自分の
                属性ではなく ItemsControl 側の添付プロパティを読むため、パネル要素に
                書いた VirtualizationMode は参照されず、Recycling が効かないまま
                コンテナが使い捨てで生成され続ける。
            -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate" Value="{StaticResource TargetRowTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TargetRowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6,5,6,4">
        <!-- メニュー / ヘッダ / 本体。接続情報のフッターは廃止(本体を広く取るため。
             同じ内容は IP設定タブの現在値で見られる) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ===== メニューバー =====
            トップレベルは MenuBarItem スタイル(自前の PART_Popup 持ち)。
            中の項目は暗黙 MenuItem スタイル(葉項目専用・サブメニュー不可)なので
            すべてフラットに並べる。Style の Setter ではなく要素へ直接置いているので
            Click の結線はずれない(CLAUDE.md 参照)。
        -->
        <Menu x:Name="MainMenu" Grid.Row="0" Margin="0,0,0,1" Background="Transparent">
            <!-- 開く直前に「保存できるか」を聞き直す。記録の画面を畳んだので、
                 ここを逃すと起動直後の判定のまま押せなくなる -->
            <MenuItem Header="ファイル(_F)" Style="{StaticResource MenuBarItem}"
                      SubmenuOpened="OnFileMenuOpened">
                <MenuItem Header="レポートを HTML で保存..." Command="{Binding Report.SaveHtmlCommand}" />
                <MenuItem Header="レポートをテキストで保存..." Command="{Binding Report.SaveTextCommand}" />
                <MenuItem Header="レポートを CSV で保存..." Command="{Binding Report.SaveCsvCommand}" />
                <Separator />
                <MenuItem Header="画面を撮って保存" InputGestureText="F12" Click="OnScreenshot" />
                <MenuItem Header="データフォルダを開く" Click="OnOpenDataFolder" />
                <Separator />
                <MenuItem Header="管理者として再起動..." Click="OnRelaunchAsAdmin" />
                <Separator />
                <MenuItem Header="終了" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="測定(_M)" Style="{StaticResource MenuBarItem}">
                <MenuItem Header="開始" InputGestureText="F5"
                          Command="{Binding Monitor.StartCommand}" Click="OnStartClicked" />
                <MenuItem Header="停止" InputGestureText="Shift+F5"
                          Command="{Binding Monitor.StopCommand}" />
                <Separator />
                <MenuItem Header="Ping の測定結果だけ消す" Click="OnClearPingResults" />
                <MenuItem Header="すべて消す（起動直後に戻す）" Click="OnClearAll" />
            </MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource MenuBarItem}">
                <MenuItem x:Name="ThemeMenuItem" Click="OnThemeToggle" />
                <MenuItem x:Name="TopmostMenuItem" Header="最前面に固定" IsCheckable="True"
                          Click="OnTopmostMenu" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource MenuBarItem}">
                <MenuItem Header="使い方を開く" Click="OnOpenUsage" />
                <MenuItem Header="バージョン情報" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- メニューの帯とヘッダを分ける罫線。ヘッダ下の罫線と同じ引き方 -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{DynamicResource Brush.Border}" />

        <!-- ===== ヘッダ ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,3,0,5">
            <TextBlock Text="PingWatcher"
                       FontSize="{DynamicResource Size.Title}"
                       Margin="0,0,14,0" VerticalAlignment="Center" />

            <!--
                測定の開始・停止と「クリア」はここから外した（2026-08-16 ユーザー指示）。
                開始と停止は Ping タブの中に、クリアはメニューバーの「測定」にある。
                ここに残すのは、伝えないと困ること（失敗など）だけにする。
            -->
            <TextBlock Text="{Binding Monitor.StatusMessage}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" MaxWidth="320"
                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

            <!-- 保存の結果。記録の画面を畳んだので、伝える場所がここしかない -->
            <TextBlock Text="{Binding Report.Status}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" MaxWidth="320"
                       TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />

            <!-- 配色の切り替え。記号だけだと意味が伝わらないので文字も添える -->
            <Button x:Name="ThemeToggle" Click="OnThemeToggle"
                    Style="{StaticResource Button.Icon}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="配色の切り替え"
                    ToolTip="ライトモードとダークモードを切り替えます。" />

            <!-- 操作の結果を短く知らせる場所(画面保存の成否など)。数秒で消える -->
            <TextBlock x:Name="HeaderNotice" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
        </StackPanel>

        <!-- 操作の帯と本体を分ける罫線。1 本引くだけで画面が締まる -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                Background="{DynamicResource Brush.Border}" Margin="0,0,0,-1" />

        <!-- ===== 本体 ===== -->
        <TabControl x:Name="MainTabs" Grid.Row="2" SelectionChanged="OnTabSelectionChanged">

            <!-- ===== 宛先(EXPing と同じ書き方でまとめて編集する) ===== -->
            <TabItem Header="宛先リスト" DataContext="{Binding Monitor}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="1 行 1 宛先。アドレスの後ろに半角スペースを空けると備考になります。行頭が # ; ' 全角スペースの行は注釈です。192.168.1.10-20 の範囲指定、192.168.1.0/24 のサブネット指定、表計算からのタブ区切り貼り付けも受け付けます。書き換えると自動で反映され、測定は止まりません。TCP で測る相手は「TCP Ping」の側に書きます（そちらは末尾の :ポート が測る先）。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="測りたい相手をまとめて書く場所です。書式は EXPing に合わせています。" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="宛先リスト" />

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="7,5" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    行頭が <Run>#</Run> <Run>;</Run> <Run>'</Run> 全角スペース の行は注釈として読み飛ばします。
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    範囲でまとめて書けます（EXPing にはない拡張）:
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.10-20</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.1-192.168.1.50</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.0/24</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="書き換えると自動で反映されます。" />
                            <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 FontSize="{DynamicResource Size.Caption}"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Ping（測定と結果の表示） ===== -->
            <TabItem x:Name="PingTab" Header="Ping" DataContext="{Binding Monitor}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="応答しない宛先が他を待たせることはありません。2 回続けて応答が無い宛先は上段の「応答なし」欄に浮き上がるので、落ちた瞬間を見逃しません。行を選ぶと下に平均・ジッタなどの詳しい統計が出ます。行を右クリックすると、その相手を TCP Ping に足したり、SSH / Telnet でつないだり、経路や名前を調べたりできます。状態は記号と文字で出ます（● 応答 / ✕ 不通 / ⊘ 拒否 / ? 名前 / … 停止）。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="宛先ごとに独立した周期で ping を並列に打ち、結果を一覧にします。" />
                        </DockPanel>


                        <!-- 操作列。開始・停止はこの画面に置く（2026-08-16 ユーザー指示で
                             ヘッダから移した）。F5 / Shift+F5 とメニューからも打てる -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="{Binding RunButtonLabel}" Command="{Binding StartCommand}"
                                    Click="OnStartClicked" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <Button Content="履歴を消去"
                                    Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="絞り込み" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="180" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,12,0"
                                     ToolTip="宛先・備考・解決したアドレスの部分一致で絞り込みます。測定は続きます。" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="行を右クリックすると、SSH/Telnet 接続や経路調査ができます。" />
                        </StackPanel>

                        <!-- 選択行の詳細。一覧に列を増やさずに済ませるための置き場 -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DetailText}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 一覧のヘッダ。両方の欄で共通なので、分割の外に出して常に最上部へ置く。
                             列幅は TargetRowTemplate と合わせること -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 左右 11px は「カード枠 1 + カード余白 6 + 行余白 4」。
                                 行側の仕切り線とヘッダの仕切り線がぴったり重なる値なので変えないこと -->
                            <Grid Margin="11,0,11,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target, Mode=TwoWay}" MinWidth="60" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark, Mode=TwoWay}" MinWidth="60" />
                                </Grid.ColumnDefinitions>

                                <!-- クリックでソート(同じ列を再クリックで昇順→降順→元の並び)。
                                     文字だけだと当たり判定が狭いので、透明の Border で列幅いっぱいに受ける -->
                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="State"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderState}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Target"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderTarget}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Comment"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderNote}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rtt"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderRtt}" Style="{StaticResource Caption}" />
                                </Border>
                                <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Loss"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderLoss}" Style="{StaticResource Caption}" />
                                </Border>
                                <TextBlock Grid.Column="5" Text="推移" Style="{StaticResource Caption}" />

                                <!-- 列の区切り線(行側と同じ色)。スプリッタの位置の目印にもなる -->
                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                <!--
                                    列幅の変更。固定列の右端を掴んで動かすと、その列だけが伸縮し、
                                    余りは可変幅の備考(列 2)が吸収する。GridSplitter は使わない —
                                    あちらは「掴んだ列と隣の列」を同時に伸縮するため、RTT を広げると
                                    ロスが潰れる不自然な動きになる(ユーザー指摘)。Thumb の DragDelta で
                                    ColumnLayout の幅を直接書き、TwoWay バインドが列定義へ反映する。
                                -->
                                <Thumb Grid.Column="0" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="State" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="1" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Target" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <!-- 備考(星列)より右の列は、幅を変えても右端は動かず左端が動く。
                                     そのため、つまみは各列の左端の境界に置き、「境界を右へ動かす=
                                     その列が縮む」の逆向きで幅を書く(境界がカーソルに 1:1 で追従する) -->
                                <Thumb Grid.Column="3" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Rtt" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="4" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Loss" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="5" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                       Tag="Spark" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,4" />
                        </StackPanel>

                        <!--
                            2 回続けて応答が無かった宛先を上、応答のある宛先を下に置く。
                            手当てが要るのは落ちている方なので、そちらを目の高さに持ってくる。
                        -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <!-- ===== 応答なし（2 回連続で失敗） ===== -->
                            <Border Grid.Row="0" Margin="0,0,0,7"
                                    Background="{DynamicResource Brush.Error.Bg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Error.Fg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownRows}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DockPanel MaxHeight="188">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Error.Fg}" />
                                        <TextBlock Text="{Binding DownHeader}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding DownRows}"
                                             SelectedItem="{Binding SelectedDownRow}"
                                             ItemContainerStyle="{StaticResource DownRowContainer}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>

                            <!-- ===== 応答あり =====
                                 応答なしの赤いカードと対になるよう、こちらも枠のある
                                 カードにする。枠が無いと 2 つの欄の境目が読み取れない。
                                 帯に地色は敷かない(暗い配色では地の緑が沈んで濁るため)。 -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Ok.Fg}" />
                                        <TextBlock Text="{Binding AliveHeader}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 仮想化を効かせるため行高は固定にしている -->
                                    <ListBox ItemsSource="{Binding AliveRows}"
                                             SelectedItem="{Binding SelectedAliveRow}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 無線 ===== -->
            <TabItem x:Name="WifiTab" Header="Wi-Fi" DataContext="{Binding Wifi}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="接続中 AP の詳細、受信強度（RSSI）の推移、周辺 AP のチャンネル混雑グラフ。「保存」でいまの状況をテキストに残せます。Windows 11 24H2 以降は OS の仕様で位置情報の許可が要ります。許可が無いと OS が情報を返さないので、画面の案内から設定を開いてください。許可を求める時機が読めなくなるため、この画面を開くまでスキャンはしません。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="つないでいる AP の詳細と、電波の強さ・チャンネルの混み具合を見ます。" />
                        </DockPanel>


                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <!-- SSID が長い環境でボタンが押し出されないよう幅を抑える -->
                                <TextBlock Text="{Binding ConnectionSummary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           MaxWidth="280" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ConnectionSummary}" />
                                <Button Content="更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                                <Button Content="保存" Command="{Binding SaveCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,10,0"
                                        ToolTip="いまの接続情報と周辺 AP の一覧をテキストで保存します。" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 位置情報が許可されていないときの案内 -->
                            <Border Background="{DynamicResource Brush.Warn.Bg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,5,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource Brush.Warn.Fg}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="Windows 11 24H2 以降、無線 LAN の情報を読むには位置情報の許可が必要です。設定で「位置情報」を有効にしてから、もう一度お試しください。" />
                                    <Button Content="設定を開く" Command="{Binding OpenLocationSettingsCommand}"
                                            Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 接続中 AP の詳細と RSSI 推移 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Ssid}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="信号" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Signal}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BSSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bssid}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="チャンネル" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Channel}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="機器" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="規格" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PhyType}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="暗号化" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Security}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="リンク速度" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LinkRate}"
                                               ToolTip="ネゴシエートされたリンク速度です。実際の通信速度ではありません。" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="アダプタ" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Adapter}"
                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="5,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="受信強度の推移（dBm・直近2分）"
                                               Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <!-- 読み方の目安。-67 dBm が通話・会議の実用下限としてよく使われる -->
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="目安: -50 以上 非常に良い ／ -60 良い ／ -67 実用圏（通話・会議はここまで） ／ -75 弱い ／ それ未満 不安定" />
                                    <controls:RssiChart Source="{Binding}" MinHeight="86" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- チャンネル混雑 -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="チャンネルの混み具合（そのチャンネルを使っている AP の数）"
                                           Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <!-- 5GHz は 18 本あるので、狭い窓では折り返して縦に積む -->
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,6">
                                        <ItemsControl ItemsSource="{Binding Channels24}" Height="98" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="22">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar" Width="14" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Accent.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="2.4 GHz" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Channels5}" Height="98" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="30">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar5" Width="18" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Info.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar5" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="5 GHz 以上" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 周辺 AP 一覧 -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.1]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.2]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.3]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.4]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.5]}" />
                            </Grid.ColumnDefinitions>
                            <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <!-- クリックでソート(昇順→降順→強い順)。透明 Border で列幅いっぱいに受ける -->
                            <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="Ssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderSsid}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Bssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBssid}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Vendor"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderVendor}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rssi"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderRssi}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Channel"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderChannel}" Style="{StaticResource Caption}" />
                            </Border>
                            <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Band"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBand}" Style="{StaticResource Caption}" />
                            </Border>
                            <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.1" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.2" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.3" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.4" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="wifi.5" DragDelta="OnTableColumnResize" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ListBox ItemsSource="{Binding AccessPoints}"
                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{DynamicResource Size.RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.1]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wifi.5]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                        <TextBlock x:Name="SsidText" Grid.Column="0" Text="{Binding Ssid}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Bssid}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Vendor}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rssi}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Channel}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding Band}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter TargetName="SsidText" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="SsidText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 差分比較（show ip route / show run を作業前後で見比べる） ===== -->
            <TabItem Header="差分比較" DataContext="{Binding DeviceCompare}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="対象は show run（既定）/ show ip route / そのまま比較。複数台ぶんを同時に抱えられるので、作業前にまとめて貼っておき、作業後にもう半分を貼るのが定石です。show ip route は行の差分ではなく構造として突き合わせるため、経過時間だけが違う行は差分になりません。「前の差分」「次の差分」で長い設定でもたどれます。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="機器の show 出力を作業前後で貼って見比べます。" />
                        </DockPanel>


                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">

                            <!--
                                機器の並び。1 回の作業で何台も設定変更することがあるので、
                                台数ぶん並べて作業前をまとめて集められるようにしている。
                            -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="削除"
                                        Command="{Binding RemoveDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="4,0,0,0"
                                        ToolTip="選んでいる機器を、貼り付けごと削除します。" />
                                <Button DockPanel.Dock="Right" Content="＋ 機器"
                                        Command="{Binding AddDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="8,0,0,0"
                                        ToolTip="比較する機器を増やします。" />
                                <TextBox DockPanel.Dock="Right" Width="150"
                                         Text="{Binding SelectedDevice.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         ToolTip="機器名。ホスト名を入れておくと記録を見返すときに分かります。" />
                                <TextBlock DockPanel.Dock="Right" Text="名前" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice}"
                                         ItemContainerStyle="{StaticResource DeviceChip}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- 起動幅(740px)では 1 行に収まらないので折り返す -->
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="対象" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <!--
                                    DisplayMemberPath は使わない。閉じているときの表示は
                                    SelectionBoxItemTemplate 経由で描かれるため、テンプレートを
                                    明示しないと選択中の項目が型名のまま出てしまう。
                                -->
                                <ComboBox Width="230" ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding SelectedMode}" Margin="0,0,10,0"
                                          ToolTip="対象ごとに貼り付けた内容は保たれます。作業前にまとめて貼っておけます。">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding StateMark, Mode=OneWay}"
                                                     Foreground="{DynamicResource Brush.Info.Fg}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="比較" Command="{Binding CompareCommand}" Margin="0,0,6,2" />
                                <Button Content="比較を停止" Command="{Binding EditCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                        ToolTip="比較をやめて貼り付け欄に戻ります。貼り付けた内容は残ります。" />
                                <Button Content="CSV で保存" Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                        ToolTip="「何が変わったか」を書き出します。" />
                                <CheckBox Content="異なる行だけ" IsChecked="{Binding OnlyDifferences}"
                                          VerticalAlignment="Center" Margin="0,0,12,2" />

                                <!-- 差分をたどる。長い設定では目で探すのが現実的でない -->
                                <Button Content="◀ 前の差分" Command="{Binding PreviousDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,4,2"
                                        ToolTip="前の差分へ移ります。先頭まで来たら末尾へ回ります。" />
                                <Button Content="次の差分 ▶" Command="{Binding NextDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,8,2"
                                        ToolTip="次の差分へ移ります。末尾まで来たら先頭へ回ります。" />
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>

                            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <!-- どの対象を貼り終えたか。作業前の取りこぼしに気づけるように -->
                            <TextBlock Text="{Binding PastedSummary}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 読むときの注意。Style は属性と要素の両方には書けないので、
                                 見た目もまとめてここで指定する -->
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <!--
                            貼り付け欄と結果は同じ場所に重ねる。
                            DockPanel は最後の子だけが残りを埋めるので、この入れ物を最後に置かないと
                            貼り付け欄が中身の高さまで縮んでしまう（show run を貼るには狭すぎた）。
                        -->
                        <Grid>
                            <!-- 貼り付け欄 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,5,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業前" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="保存" Command="{Binding SaveBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180" />
                                </DockPanel>

                                <DockPanel Grid.Column="1" Margin="5,0,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業後" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="保存" Command="{Binding SaveAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180" />
                                </DockPanel>
                            </Grid>

                            <!-- 結果 -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <!-- 経路として見た変化。行の差分より先に見てほしい -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,5" Padding="7,5"
                                        Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Card}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStructuredView}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel MaxHeight="180">
                                        <TextBlock DockPanel.Dock="Top" Text="何が変わったか"
 Margin="0,0,0,4" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="ChangeText" Text="{Binding Description}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                                <Setter TargetName="ChangeText" Property="FontWeight" Value="Normal" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- 左右の見出し -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="作業前" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="作業後" Style="{StaticResource Caption}" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                                <!-- 左右並置。1 つのスクロールに収めるので、左右がずれない -->
                                <ListBox x:Name="DiffList"
                                         ItemsSource="{Binding Rows}"
                                         ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding LeftNumberText}"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Right" Margin="0,0,6,0" />

                                                <!-- 行の中の違う箇所だけ地色を変える(WinMerge の行内色分け)。
                                                     消えた側は Error.Bg、増えた側は Ok.Bg — 行全体の色と同じ語彙 -->
                                                <Border x:Name="LeftCell" Grid.Column="1" Padding="4,1" CornerRadius="{DynamicResource Radius.Chip}" Margin="0,0,6,0">
                                                    <controls:DiffText Segments="{Binding LeftSegments}"
                                                                       ChangedBrush="{DynamicResource Brush.Error.Bg}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       TextWrapping="NoWrap" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding RightNumberText}"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Right" Margin="0,0,6,0" />

                                                <Border x:Name="RightCell" Grid.Column="3" Padding="4,1" CornerRadius="{DynamicResource Radius.Chip}">
                                                    <controls:DiffText Segments="{Binding RightSegments}"
                                                                       ChangedBrush="{DynamicResource Brush.Ok.Bg}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                                                    <Setter TargetName="LeftCell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                                                    <Setter TargetName="RightCell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                                                    <Setter TargetName="LeftCell" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                                                    <Setter TargetName="RightCell" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 遮断（WFP が落とした通信。読み取りにも管理者権限が要る） ===== -->
            <TabItem x:Name="WfpTab" Header="WFP" DataContext="{Binding Wfp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="WFP は Windows Filtering Platform の略で、ファイアウォールやセキュリティ製品が通信を落とすときに通る仕組みです。いつ・どのアプリが・どこへ出ようとして落とされたかが分かります。読み取りにも管理者権限が要ります。さらに Windows は既定でこの記録を取っていないので、0 件のままなら「記録を有効にする」を押してください（PC 全体に効く設定で、閉じるとき元に戻します）。ここに出るのはこの PC の WFP が落としたものだけで、相手側やネットワーク機器で落とされた通信は出ません。プロセスが「—」なのは不具合ではありません。受信の遮断は通信が届く前に落ちているので、持ち主のアプリが存在しません。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Windows 自身が落とした通信の一覧です。「繋がらないが原因が分からない」ときの最後の砦。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="一時停止" IsChecked="{Binding IsPaused}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="更新を止めて、じっくり読んだり選択したりできます。" />
                            <TextBlock Text="絞り込み" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,0"
                                     ToolTip="プロセス名・パス・アドレス・プロトコルの部分一致で絞り込みます。" />
                            <Button Content="更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <!-- 案内は 2 段構え: 文言の有無で畳み、ボタンはそれぞれの条件で出す -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="管理者として再起動" Click="OnRelaunchAsAdmin"
                                    Style="{StaticResource Button.Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="いったん終了して、管理者権限で起動し直します。測定中の結果は失われます。" />
                            <Button DockPanel.Dock="Right" Content="記録を有効にする" Click="OnEnableWfpCollection"
                                    Style="{StaticResource Button.Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanEnableCollection, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Windows にネットワークイベントの記録を始めさせます。アプリを閉じると元に戻します。" />
                            <TextBlock Text="{Binding Notice}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Warn.Fg}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.2]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.3]}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.5]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.6]}" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag=""
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding TimeHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Direction"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding DirectionHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Protocol"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding ProtocolHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Local"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding LocalHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Remote"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding RemoteHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Process"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding ProcessHeader}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="6" Background="Transparent" Cursor="Hand" Tag="Count"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順）">
                                        <TextBlock Text="{Binding CountHeader}" Style="{StaticResource Caption}" />
                                    </Border>

                                    <!-- 列幅のつまみ。星列(3・4)より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.0" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.1" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.2" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="wfp.3" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="wfp.5" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="wfp.6" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                <ListBox ItemsSource="{Binding Rows}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <!-- 行の詰め方は接続タブと同じ。既定の ListBoxItem は
                                         余白を持つので、指定しないと 1 行ぶん背が高くなる -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 説明はプロセス欄に付ける。行全体に付けるとパスが空のとき空の枠が出る -->
                                            <Grid Height="{DynamicResource Size.RowHeight}"
                                                  ContextMenu="{StaticResource RowMenu.Address}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.3]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.5]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[wfp.6]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DirectionText" Grid.Column="1" Text="{Binding DirectionText}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Protocol}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Local}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5" Text="{Binding ProcessName}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessNote}" />
                                                <TextBlock Grid.Column="6" Text="{Binding CountText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </Grid>

                                            <!--
                                                送信と受信で色を変える。既存のパレットから選んでいるので
                                                新しい色は足していない(明暗どちらの配色でもコントラストは検算済み)。
                                                色だけに頼らないよう、文字は「→ 送信」「← 受信」のまま残す。
                                                向きが読めなかった行は色を付けない(生の値を出したまま)。
                                            -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                                    <Setter TargetName="DirectionText" Property="Foreground"
                                                            Value="{DynamicResource Brush.Info.Fg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInbound}" Value="True">
                                                    <Setter TargetName="DirectionText" Property="Foreground"
                                                            Value="{DynamicResource Brush.Warn.Fg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== IP設定（この PC の IPv4 設定を切り替える。適用時だけ UAC 昇格） ===== -->
            <TabItem x:Name="IpConfigTab" Header="IP設定" DataContext="{Binding IpConfig}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="アダプタを選ぶと現在の設定が入力欄に入ります。DHCP と固定 IP を切り替えられ、よく使う現場の設定はプリセットとして名前を付けて保存できます。適用のときだけ UAC の確認が 1 回出ます（アプリ自体は管理者になりません）。リモートデスクトップ越しの操作では、適用した瞬間に通信が切れることがあるので注意してください。下段のプロキシ（使わない / PAC / 固定サーバ）は管理者権限も UAC も要りません。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="この PC の IPv4 設定とプロキシ設定を切り替えます。" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="アダプタ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                            <ComboBox Width="300"
                                      ItemsSource="{Binding Adapters}"
                                      SelectedItem="{Binding SelectedAdapter}"
                                      Margin="0,0,6,2"
                                      ToolTip="設定するアダプタ。抜けている(未接続の)アダプタも選べます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="再読み込み" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{Binding SelectedAdapter.Description}" />

                        <CheckBox DockPanel.Dock="Top" Content="DHCP で自動取得する" IsChecked="{Binding UseDhcp}"
                                  Margin="0,0,0,6"
                                  ToolTip="チェックを外すと下の固定 IP 設定を使います。" />

                        <!-- グレーアウトは分かりづらい(ユーザー指摘)ので、DHCP のときは丸ごと畳む -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
                              Visibility="{Binding UseStatic, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP アドレス" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="マスク" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                     ToolTip="255.255.255.0 でも 24 でも /24 でも書けます。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ゲートウェイ" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                     ToolTip="空欄ならゲートウェイなしで設定します。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="優先 DNS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="代替 DNS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,4"
                                     ToolTip="DNS を両方空欄にすると、DNS の設定はクリアされます。" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding ValidationText}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.Warn.Fg}" />

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="プリセット" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                            <ComboBox Width="160"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      Margin="0,0,8,2"
                                      ToolTip="選ぶと内容が入力欄に入ります(適用はされません)。">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="名前" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                            <TextBox Width="120" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,2" ToolTip="現場名など(例: 現場A)。同じ名前は上書きされます。" />
                            <Button Content="保存" Command="{Binding SavePresetCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,5,2"
                                    ToolTip="いまの入力内容をこの名前で保存します。" />
                            <Button Content="削除" Command="{Binding DeletePresetCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="適用" Click="OnApplyIpConfig" IsEnabled="{Binding CanApply}"
                                    Margin="0,0,12,0"
                                    ToolTip="確認の後、UAC の昇格を経て netsh で設定します。" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="適用には管理者権限が必要です(UAC の確認が 1 回出ます)。アプリ自体は非管理者のまま動きます。この PC の通信が一時的に切れることがあります。" />

                        <!-- ===== プロキシ(WinINET のユーザー設定。管理者権限は不要) ===== -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,8" />

                        <StackPanel DockPanel.Dock="Top" DataContext="{Binding Proxy}">
                            <WrapPanel Margin="0,0,0,4">
                                <TextBlock Text="プロキシ" VerticalAlignment="Center" Margin="0,0,8,2" />
                                <ComboBox Width="190"
                                          ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding SelectedMode}"
                                          Margin="0,0,8,2">
                                    <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding CurrentSummary}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentSummary}" Margin="0,0,0,2" />
                            </WrapPanel>

                            <!-- 選んだ方式の行だけ出す(グレーアウトは分かりづらい、というユーザー指摘) -->
                            <WrapPanel Margin="0,0,0,4"
                                       Visibility="{Binding IsPac, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="PAC の URL" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                <TextBox Width="320" Text="{Binding PacUrl, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,2"
                                         ToolTip="例: http://proxy.example.co.jp/proxy.pac" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,4"
                                       Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="サーバ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                <TextBox Width="200" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,2"
                                         ToolTip="例: proxy.example.co.jp:8080(プロトコル別は http=…;https=… の書式)" />
                                <TextBlock Text="除外" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,2" />
                                <TextBox Width="220" Text="{Binding Bypass, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}" Margin="0,0,0,2"
                                         ToolTip="プロキシを通さない宛先。; 区切り。&lt;local&gt; はローカルアドレスの意味。" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="プロキシを適用" Command="{Binding ApplyCommand}" Margin="0,0,12,0"
                                        ToolTip="Windows のプロキシ設定(現在のユーザー)に反映します。管理者権限は不要です。" />
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Border />
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 記録 ===== -->
            <!-- ===== 試験（業務確認試験。プロキシを切り替えて同じ試験を回せる） ===== -->
            <TabItem x:Name="VerifyTab" Header="業務確認" DataContext="{Binding Verify}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="ネットワークやプロキシを入れ替えたあとの業務確認試験を、判定できるところまで肩代わりします。プロキシを切り替えて同じ試験を回せるので、入れ替えの前後を並べて比べられます。HTTP は応答コードだけでは合格にしません（遮断ページは HTTP 200 で返るため、本文と最終 URL も見ます）。Teams は音声が通る UDP まで確かめます。ブラウザでしか開けないページは開くところまで肩代わりし、合否は人が付けます。結果は CSV と HTML の報告書にできます。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Web・Teams・メールが使えるかをまとめて試験し、証跡として書き出します。" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <ComboBox Width="200" Margin="0,0,6,2"
                                      ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      ToolTip="試験項目のひな型です。入れてから宛先を書き換えます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="ひな型を入れる" Command="{Binding ApplyTemplateCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="いまの項目を置き換えます。" />
                            <Button Content="項目を読み込む" Command="{Binding LoadItemsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="保存しておいた試験項目のファイルを読み込みます（いまの項目は置き換わります）。" />
                            <Button Content="項目を保存" Command="{Binding SaveItemsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="いまの試験項目をファイルに保存します。現場ごとに使い分けたり、人に渡したりできます。" />

                            <Button Content="まとめて実行" Command="{Binding StartCommand}" Margin="0,0,6,2" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="試験成績書へ貼れる形で書き出します。" />
                            <Button Content="HTML で保存" Command="{Binding SaveHtmlCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2"
                                    ToolTip="そのままメールに添付できる報告書にします。1 ファイル完結なのでオフラインでも開けます。" />
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <!--
                            試験の進み具合。項目数 × プロキシの本数だけ逐次に回すので、
                            まとめて実行すると何分もかかる。押したあと何も起きないように見せない。
                            結果は 1 件終わるごとに下の一覧へ足していく。
                        -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,6"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="8,6"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" MinWidth="56" TextAlignment="Right" />

                                <!-- RangeBase.Value は既定が TwoWay。読み取り専用なので OneWay を明示する -->
                                <ProgressBar DockPanel.Dock="Top" Height="6" Margin="0,0,0,6"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />

                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Ok.Bg}">
                                        <TextBlock Style="{StaticResource Badge.Text}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}">
                                            <Run Text="○ 合格 " /><Run Text="{Binding PassCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Error.Bg}">
                                        <TextBlock Style="{StaticResource Badge.Text}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}">
                                            <Run Text="✕ 不合格 " /><Run Text="{Binding FailCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Warn.Bg}">
                                        <TextBlock Style="{StaticResource Badge.Text}"
                                                   Foreground="{DynamicResource Brush.Warn.Fg}">
                                            <Run Text="△ 注意 " /><Run Text="{Binding WarnCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Background="{DynamicResource Brush.Info.Bg}">
                                        <TextBlock Style="{StaticResource Badge.Text}"
                                                   Foreground="{DynamicResource Brush.Info.Fg}">
                                            <Run Text="◍ 目視 " /><Run Text="{Binding PersonCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <!-- いま試している項目。終わると消える -->
                                    <TextBlock Text="{Binding RunningName}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- プロキシ。定義（左）と、そのうちどれで試すか（右） -->
                        <Border DockPanel.Dock="Top" MaxHeight="96" Margin="0,0,0,6"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,3"
                                               Text="プロキシの一覧（1 行 1 件・名前,pac または proxy,アドレス）" />
                                    <TextBox Text="{Binding ProxyText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             ToolTip="例: Zscaler,pac,http://pac.zscaler.net/example/proxy.pac" />
                                </DockPanel>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="試すプロキシ" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Proxies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,2"
                                                              Content="{Binding Name}" ToolTip="{Binding Summary}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- 上: 試験項目（編集）。窓の幅が足りないので結果とは縦に積む -->
                        <Border DockPanel.Dock="Top" MaxHeight="240" Margin="0,0,0,6"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.2]}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.4]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.5]}" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="0" Text="削除" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="項目名" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="種類" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="宛先" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="4" Text="期待" Style="{StaticResource Caption}"
                                               ToolTip="本文にこの文字列が含まれることまで確かめます（HTTP のみ）。遮断ページを合格と誤読しないための確実な手です。" />
                                    <TextBlock Grid.Column="5" Text="結果" Style="{StaticResource Caption}" />
                                    <!-- 列幅のつまみ。星列(3)より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="verify.0" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="verify.1" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="verify.2" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="verify.4" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="verify.5" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                <!-- 「行を追加」を先に下端へ留めてから、一覧に残りを埋めさせる -->
                                <Button DockPanel.Dock="Bottom" Content="＋ 行を追加"
                                        Command="{Binding AddRowCommand}"
                                        Style="{StaticResource Button.Subtle}"
                                        HorizontalAlignment="Left" Margin="4,4,0,0" />

                                <ListBox ItemsSource="{Binding Rows}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.2]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.4]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[verify.5]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                                <Button Grid.Column="0" Content="✕"
                                                        Style="{StaticResource Button.Subtle}"
                                                        Command="{Binding DataContext.RemoveRowCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Width="16" Height="16"
                                                        Padding="0" MinWidth="0" MinHeight="0"
                                                        FontSize="{DynamicResource Size.Micro}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                                        ToolTip="この行を消します。" />

                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="{DynamicResource Size.Caption}"
                                                         Margin="0,0,4,0" VerticalAlignment="Center"
                                                         ToolTip="試験成績書にそのまま出る名前です。" />

                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Kinds}"
                                                          SelectedItem="{Binding Kind}"
                                                          FontSize="{DynamicResource Size.Caption}"
                                                          VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBox Grid.Column="3" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="{DynamicResource Font.Mono}"
                                                         FontSize="{DynamicResource Size.Caption}"
                                                         Margin="0,0,4,0" VerticalAlignment="Center"
                                                         ToolTip="{Binding TargetHint}" />

                                                <TextBox Grid.Column="4" Text="{Binding Expect, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="{DynamicResource Size.Caption}"
                                                         Margin="0,0,4,0" VerticalAlignment="Center"
                                                         ToolTip="本文にこの文字列が含まれることまで確かめます（HTTP のみ）。" />

                                                <TextBlock Grid.Column="5" Text="{Binding Status}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 下: 結果。1 行 = 1 項目 × 1 プロキシ -->
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="結果（1 行 = 1 項目 × 1 プロキシ）"
                                           Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent"
                                      Tag="vres" MouseLeftButtonDown="OnTableHeaderSort">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.2]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.3]}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="0" Text="項目" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="プロキシ" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="合否" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="所要" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="4" Text="詳細" Style="{StaticResource Caption}" />
                                    <!-- 列幅のつまみ。星列(4)より左なので右端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="vres.0" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="vres.1" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="vres.2" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="vres.3" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                <!-- TargetListBox は Ping 用の ItemTemplate を既定で当ててくるので使わない。
                                     ここは自前のテンプレートを 1 つ置くだけ -->
                                <ListBox ItemsSource="{Binding Results}" Tag="vres"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[vres.3]}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProxyText}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ProxyText}" />
                                                <TextBlock x:Name="VerdictText" Grid.Column="2" Text="{Binding VerdictText}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />

                                                <!-- 目視の項目だけ、その場で合否を付けられるようにする。
                                                     アプリからは判定できないページがあるため -->
                                                <StackPanel x:Name="MarkButtons" Grid.Column="2" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Visibility="Collapsed">
                                                    <Button Content="○" Margin="0,0,2,0"
                                                            Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                            FontSize="{DynamicResource Size.Micro}"
                                                            Style="{StaticResource Button.Subtle}"
                                                            Command="{Binding DataContext.MarkPassCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="目視で確認できたので合格にします。" />
                                                    <Button Content="✕"
                                                            Width="18" Height="16" Padding="0" MinWidth="0" MinHeight="0"
                                                            FontSize="{DynamicResource Size.Micro}"
                                                            Style="{StaticResource Button.Subtle}"
                                                            Command="{Binding DataContext.MarkFailCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="目視で問題があったので不合格にします。" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding ElapsedText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Detail}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                            </Grid>

                                            <!-- 合否は文字で出したうえで色を添える（色だけで表さない） -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFail}" Value="True">
                                                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NeedsPerson}" Value="True">
                                                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                                    <Setter TargetName="MarkButtons" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 調べる（相手や自分の状態を確かめる道具） ===== -->
            <TabItem x:Name="ProbeTab" Header="調べる　7 ▾">
                <DockPanel>
                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                   ToolTip="TCP Ping・Traceroute・スキャン・DNS・SNMP Get・通信状況・サブネット計算。どれも単発で使う道具なので、1 つにまとめて畳んであります。" />
                        <TextBlock Style="{StaticResource TabIntro}" Text="相手や自分の状態を確かめる道具です。左のメニューから選んでください。" />
                    </DockPanel>

                    <!-- 左の縦メニューで中身を選ぶ。項目が増えても名前を省略せずに置ける -->
                    <TabControl TabStripPlacement="Left"
                                ItemContainerStyle="{StaticResource MenuTabItem}"
                                BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <!-- メニューの列。名前が読める幅を固定で取る -->
                            <Style TargetType="TabPanel">
                                <Setter Property="Width" Value="128" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </TabControl.Resources>

            <!-- ===== TCP（接続できるかで測る。ICMP が塞がれている相手向け） ===== -->
            <TabItem x:Name="TcpTab" Header="TCP Ping" DataContext="{Binding Tcp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="結果は 3 状態で出ます — つながる / 拒否（ホストは生きているがポートが閉じている）/ 無応答。この区別が切り分けの決め手になります。宛先は Ping とは別に持ち、末尾の :ポート がつなぐ先です（省略すると画面の既定ポート）。測定用の接続はデータを流さず即座に閉じるので、相手に負担はかけません。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="TCP でつないで測ります。ping（ICMP）が塞がれている相手の確認に。" />
                        </DockPanel>


                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="{Binding RunButtonLabel}" Command="{Binding StartCommand}"
                        Click="OnStartClicked" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,10,0" />

                            <TextBlock Text="既定ポート" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="56" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     ToolTip="宛先に :ポート が書いていないときに使うポート。" />

                            <Button Content="履歴を消去" Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 宛先。Ping とは別に持つ -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,5"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="7,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="1 行に 1 宛先。末尾の :ポート が測る先です（例 srv-01:445）。省略すると上の既定ポートを使います。書き換えると自動で反映されます。" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListSummary}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="86" Margin="0,4,0,0"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Size.Caption}"
                                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top" />
                            </DockPanel>
                        </Border>

                        <!-- 選んだ行の詳しい統計 -->
                        <Border DockPanel.Dock="Bottom" Margin="0,5,0,0"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5">
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 結果。Ping と同じく、つながらない方を上に置く -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,7"
                                    Background="{DynamicResource Brush.Error.Bg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Error.Fg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownRows}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DockPanel MaxHeight="188">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Error.Fg}" />
                                        <TextBlock Text="{Binding DownHeader}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}"
 VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding DownRows}"
                                             SelectedItem="{Binding SelectedDownRow}"
                                             ItemContainerStyle="{StaticResource DownRowContainer}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>

                            <!-- 応答なしの赤いカードと対になる枠。境目をはっきりさせる -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Ok.Fg}" />
                                        <TextBlock Text="{Binding AliveHeader}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}"
 VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding AliveRows}"
                                             SelectedItem="{Binding SelectedAliveRow}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 経路 ===== -->
            <TabItem x:Name="TraceTab" Header="Traceroute" DataContext="{Binding Trace}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="TTL を並列に投げるので速く終わります（レート制限を避けるため少しずつずらして投げます）。経路の見張りは ECMP による誤検知を避けるため、2 回続けて変わったときだけ「変化」と判定します。Path MTU にはブラックホールがあり、ICMP を返さないルータがあると「大きすぎる」ではなく「無応答」になります。両者は書き分けています。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="相手までの経路をたどります。Path MTU 探索と経路変化の見張りつき。" />
                        </DockPanel>


                        <!-- 起動幅では 1 行ぎりぎりなので折り返せるようにしておく -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <TextBlock Text="宛先" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,2" />
                            <TextBox Width="240"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,2" />
                            <Button Content="経路を調べる" Command="{Binding TraceCommand}" Margin="0,0,6,2" />
                            <Button Content="MTU を調べる" Command="{Binding MtuCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="経路上で分割せずに通る最大パケットサイズを二分探索で求めます。" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,10,2"
                                    ToolTip="ホップ一覧と、経路が変わった記録を書き出します。" />
                            <CheckBox Content="60秒ごとに見張る" IsChecked="{Binding IsWatching}"
                                      VerticalAlignment="Center" Margin="0,0,10,2"
                                      ToolTip="定期的に経路を調べ直し、変わったら下に記録します。" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>

                        <!-- 経路が変わった記録 -->
                        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" MaxHeight="96"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- 変化が 1 件も無いうちは場所を取らない -->
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="何が変わったか" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Changes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MtuText}"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="4,6,0,0" />

                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="trace" MouseLeftButtonDown="OnTableHeaderSort">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.0]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.1]}" />
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.3]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.4]}" />
                            </Grid.ColumnDefinitions>
                            <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <TextBlock Grid.Column="0" Text="#"      Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="IP"     Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="ホスト名" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="RTT"    Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="状態"   Style="{StaticResource Caption}" Margin="10,0,0,0" />
                            <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                            <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                   Tag="trace.0" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                   Tag="trace.1" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="trace.3" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="trace.4" DragDelta="OnTableColumnResize" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <!-- 見出しは一覧の外にあるので、スクロールバーの場所は常に空けておく。
                             出たり消えたりすると、そのぶん行だけ狭くなって見出しとずれる -->
                        <ScrollViewer VerticalScrollBarVisibility="Visible">
                            <ItemsControl ItemsSource="{Binding Hops}" Tag="trace">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="{DynamicResource Radius.Badge}" Padding="4,0">
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.1]}" />
                                                    <ColumnDefinition Width="*" MinWidth="140" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.3]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[trace.4]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                                <TextBlock x:Name="TtlText" Grid.Column="0" Text="{Binding Ttl}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AddressText" Grid.Column="1" Text="{Binding Address}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding HostName}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Rtt}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Note}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <!-- 応答が無かったホップは沈める -->
                                            <DataTrigger Binding="{Binding Responded}" Value="False">
                                                <Setter TargetName="AddressText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Setter TargetName="TtlText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                            <!-- 宛先に届いた行を目立たせる -->
                                            <DataTrigger Binding="{Binding IsDestination}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                <Setter TargetName="AddressText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                <Setter TargetName="AddressText" Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== スキャン ===== -->
            <TabItem Header="スキャン" DataContext="{Binding Scan}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="応答した機器の MAC・ベンダー名・ホスト名を一覧にします。そのまま宛先リストへ追加できます。ポート調査は既定で無効です。有効にすると、よく使う 22 ポートへ順に接続を試みます。ウイルス対策ソフトや EDR が反応することがあるので、自分が管理権限を持つネットワークでのみ使ってください。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="範囲を指定してサブネットを掃き、そこに居る機器を洗い出します。" />
                        </DockPanel>


                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <!-- 起動幅では 1 行に収まらないので折り返す -->
                            <WrapPanel>
                                <TextBlock Text="範囲" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,2" />
                                <TextBox Width="260"
                                         Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         Margin="0,0,8,2" />
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,12,2" />
                                <CheckBox Content="ホスト名を引く" IsChecked="{Binding ResolveNames}"
                                          VerticalAlignment="Center" Margin="0,0,12,2" />
                                <CheckBox Content="ポートも調べる" IsChecked="{Binding ScanPorts}"
                                          VerticalAlignment="Center" Margin="0,0,12,2"
                                          ToolTip="よく使う22ポートだけを調べます。ウイルス対策ソフトが反応する場合があります。" />
                                <Button Content="スキャン" Command="{Binding ScanCommand}" Margin="0,0,6,2" />
                                <Button Content="中断" Command="{Binding CancelCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                <Button Content="宛先に追加" Command="{Binding AddToTargetsCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,0,2"
                                        ToolTip="スキャン結果(IP・RTT・ホスト名・MAC・ベンダー・開放ポート)を CSV に保存します。" />
                            </WrapPanel>

                            <!-- RangeBase.Value は既定が TwoWay。読み取り専用プロパティに繋ぐので OneWay を明示する -->
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,5,0,0" />

                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 一覧のヘッダ -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="scan" MouseLeftButtonDown="OnTableHeaderSort">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.0]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.1]}" />
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.3]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.4]}" />
                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.5]}" />
                            </Grid.ColumnDefinitions>
                            <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                            <TextBlock Grid.Column="0" Text="IP"       Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="RTT"      Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="ホスト名" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="3" Text="MAC"      Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="ベンダー" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="開放ポート" Style="{StaticResource Caption}" />
                            <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                            <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                   Tag="scan.0" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                   Tag="scan.1" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="scan.3" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="scan.4" DragDelta="OnTableColumnResize" />
                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Tag="scan.5" DragDelta="OnTableColumnResize" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ListBox ItemsSource="{Binding Results}"
                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{DynamicResource Size.RowHeight}"
                                          ContextMenu="{StaticResource RowMenu.Device}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.0]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.1]}" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[scan.5]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Rtt}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding HostName}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Mac}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Vendor}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding Ports}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== DNS ===== -->
            <TabItem x:Name="DnsTab" Header="DNS" DataContext="{Binding Dns}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="「社内 DNS では引けるが外部では引けない」の切り分けに使います。A / AAAA / CNAME / MX / NS / TXT / SOA / SRV / PTR に対応。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="同じ名前を複数の DNS サーバへ同時に問い合わせ、答えを横並びで比べます。" />
                        </DockPanel>


                        <!-- 入力 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="名前" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="240"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0" />
                            <ComboBox Width="86"
                                      ItemsSource="{Binding RecordTypes}"
                                      SelectedItem="{Binding SelectedType}"
                                      Margin="0,0,6,0" />
                            <Button Content="問い合わせ" Command="{Binding QueryCommand}" Margin="0,0,6,0" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,10,0"
                                    ToolTip="サーバごとの回答を 1 枚の表にします。回答が無かったサーバも 1 行残します。" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 問い合わせ先 -->
                        <DockPanel DockPanel.Dock="Left" Width="164" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="問い合わせ先（1 行に 1 台）。「システム既定」と書くと OS のリゾルバを使います。" />
                            <TextBox Text="{Binding ServersText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </DockPanel>

                        <!-- 結果を横並びで比較する -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card"
                                                Background="{DynamicResource Brush.SurfaceAlt}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Card}"
                                                Padding="7,5"
                                                Margin="0,0,8,8"
                                                Width="278">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ServerLabel}"

                                                           FontFamily="{DynamicResource Font.Mono}" />
                                                <TextBlock x:Name="SummaryText"
                                                           Text="{Binding Summary}"
                                                           Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,6" />

                                                <ItemsControl ItemsSource="{Binding Records}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Style="{StaticResource Badge}"
                                                                        Background="{DynamicResource Brush.Info.Bg}"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding Type}"
                                                                               Style="{StaticResource Badge.Text}"
                                                                               Foreground="{DynamicResource Brush.Info.Fg}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           Style="{StaticResource Mono}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="6,0,6,0" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding TtlText}"
                                                                           Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Top" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                                                <Setter TargetName="SummaryText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== SNMP（GET / ウォーク） ===== -->
            <TabItem x:Name="SnmpTab" Header="SNMP Get" DataContext="{Binding SnmpGet}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="sysDescr などよく使う OID のプリセットがあります。Trap の受信は「受ける」の中にあります。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="機器の値を SNMP で取ります（v1 / v2c の GET とウォーク）。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="宛先" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="140" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,12,0"
                                     ToolTip="機器の IP。" />
                            <TextBlock Text="コミュニティ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0" />
                            <CheckBox Content="v2c" IsChecked="{Binding IsV2c}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="外すと v1 で問い合わせます。" />
                            <Button Content="取得" Command="{Binding GetCommand}" Margin="0,0,6,0" />
                            <Button Content="ウォーク" Command="{Binding WalkCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,0"
                                    ToolTip="ウォークは最大 5000 行まで走ります。" />
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="OID" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="240" Text="{Binding OidText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,8,0" />
                            <ComboBox Width="220"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      ToolTip="よく使う OID を選ぶと上の欄に入ります。" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="snmpget" MouseLeftButtonDown="OnTableHeaderSort">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.1]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.2]}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="0" Text="OID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="名前" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="型" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="値" Style="{StaticResource Caption}" />
                                    <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.0" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.1" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="snmpget.2" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />
                                <ListBox ItemsSource="{Binding Rows}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[snmpget.2]}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Oid}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Value}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 接続（この PC の TCP/UDP 通信をプロセスごとに見る） ===== -->
            <TabItem x:Name="ConnectionsTab" Header="通信状況" DataContext="{Binding Connections}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="TCP / UDP の接続をプロセスごとにまとめて表示します（リソースモニター風）。既定は一時停止で、開いた瞬間の 1 枚だけを出します。外すと 2 秒ごとに追いかけます。通信量（送受信 B/秒）だけは管理者権限が要ります（ETW という OS の仕組みの制限）。非管理者では「—」になり、案内から昇格して起動し直せます。接続一覧そのものは非管理者で見えます。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="この PC のどのプロセスがどこと通信しているかを見ます。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="一時停止" IsChecked="{Binding IsPaused}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="更新を止めて、じっくり読んだり選択したりできます。" />
                            <TextBlock Text="絞り込み" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}" Margin="0,0,10,0"
                                     ToolTip="プロセス名・アドレス・ポート・状態の部分一致で絞り込みます。" />
                            <ComboBox Width="160"
                                      ItemsSource="{Binding StateFilters}"
                                      SelectedItem="{Binding SelectedStateFilter}"
                                      ToolTip="状態で絞り込みます(テキスト絞り込みと併用できます)。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="10,0,0,0"
                                    ToolTip="いま見えている行を書き出します(絞り込みと並べ替えの結果を含みます)。" />
                        </StackPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding HasRateNotice, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="管理者として再起動" Click="OnRelaunchAsAdmin"
                                    Style="{StaticResource Button.Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="いったん終了して、管理者権限で起動し直します。測定中の結果は失われます。" />
                            <TextBlock Text="{Binding RateNotice}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Warn.Fg}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.0]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.1]}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.3]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.4]}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.5]}" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                    <!-- クリックでソート(昇順→降順→既定)。透明 Border で列幅いっぱいに受ける -->
                                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="Protocol"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                        <TextBlock Text="{Binding HeaderProtocol}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Local"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                        <TextBlock Text="{Binding HeaderLocal}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Remote"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                        <TextBlock Text="{Binding HeaderRemote}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="State"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                        <TextBlock Text="{Binding HeaderState}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Sent"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（グループもこの列の合計順になります）">
                                        <TextBlock Text="{Binding HeaderSent}" Style="{StaticResource Caption}" />
                                    </Border>
                                    <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Received"
                                            MouseLeftButtonDown="OnListHeaderSort"
                                            ToolTip="クリックで並べ替え（グループもこの列の合計順になります）">
                                        <TextBlock Text="{Binding HeaderReceived}" Style="{StaticResource Caption}" />
                                    </Border>

                                    <!-- 列幅のつまみ。星列(1・2)より左は右端、右は左端の境界に置く -->
                                    <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="conn.0" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                           Tag="conn.1" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="conn.3" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="conn.4" DragDelta="OnTableColumnResize" />
                                    <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                           Tag="conn.5" DragDelta="OnTableColumnResize" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />
                                <!-- TargetListBox スタイルは Ping 用の ItemTemplate を既定で当ててくる。
                                     ここは型別の暗黙テンプレートで出し分けるので、明示的に外す
                                     (外し忘れると全行が Ping の「◌ 待機」バッジで描かれる。実際にやらかした) -->
                                <ListBox ItemsSource="{Binding Rows}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemTemplate="{x:Null}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.Resources>
                                        <!-- 見出し行(プロセス)と接続行を型で出し分ける -->
                                        <DataTemplate DataType="{x:Type net:ConnectionGroupRow}">
                                            <!-- 行の左右 4px は PlainRowContainer が持っている。
                                                 ここで足すと二重になり、接続行と見出しから 4px ずれる -->
                                            <Border Height="{DynamicResource Size.RowHeight}"
                                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.0]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.1]}" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.3]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.4]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.5]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PidText}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" Text="{Binding SentText}" Style="{StaticResource Mono}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ReceivedText}" Style="{StaticResource Mono}"
                                                               FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type net:ConnectionDetailRow}">
                                            <Grid Height="{DynamicResource Size.RowHeight}"
                                                  ContextMenu="{StaticResource RowMenu.Address}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.0]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.1]}" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.3]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.4]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[conn.5]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="{Binding Protocol}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Local}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Local}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}" />
                                                <TextBlock Grid.Column="3" Text="{Binding StateText}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateKind}" Value="Ok">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StateKind}" Value="Info">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding SentText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{Binding ReceivedText}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.Resources>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 電卓（サブネット計算と早見表） ===== -->
            <TabItem Header="サブネット計算" DataContext="{Binding Subnet}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="ネットワークアドレス / ブロードキャスト / ホスト範囲 / 分割案を表示します。/8〜/32 のマスク早見表つき。現場で暗算しないための道具です。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="CIDR やマスク付き IP から、範囲・分割案・マスク早見表を出します。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="サブネット" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="240"
                                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     ToolTip="192.168.1.0/24 または 192.168.1.0 255.255.255.0 の形で入力します。" />
                            <TextBlock Text="{Binding ErrorText}"
                                       Foreground="{DynamicResource Brush.Error.Fg}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="252" />
                            </Grid.ColumnDefinitions>

                            <!-- 計算結果と分割案 -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                          Margin="0,0,10,0">
                                <StackPanel>
                                    <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="ネットワーク" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource CopyableValue}" Text="{Binding NetworkText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Text="ブロードキャスト" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyableValue}" Text="{Binding BroadcastText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Text="マスク" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource CopyableValue}" Text="{Binding MaskText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Text="ホスト範囲" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource CopyableValue}" Text="{Binding RangeText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="4" Text="使えるホスト数" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                        <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource CopyableValue}" Text="{Binding HostCountText, Mode=OneWay}" />
                                    </Grid>

                                    <!-- 分割案 -->
                                    <ItemsControl ItemsSource="{Binding Splits}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Header}"
                                                               Foreground="{DynamicResource Brush.Accent.Fg}"
 Margin="0,0,0,3" />
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBox Style="{StaticResource CopyableValue}" Text="{Binding Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 早見表 -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="8,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="早見表"
                                               Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="長さ" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="マスク" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="ホスト数" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Static vm:SubnetViewModel.CheatSheet}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="76" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Prefix}" Style="{StaticResource Mono}" FontSize="{DynamicResource Size.Caption}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Mask}" Style="{StaticResource Mono}" FontSize="{DynamicResource Size.Caption}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Hosts}" Style="{StaticResource Mono}" FontSize="{DynamicResource Size.Caption}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>


                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- ===== 機器（Cisco 機器から集める・集めたものを読む） ===== -->
            <TabItem x:Name="DeviceTab" Header="NW機器　3 ▾">
                <DockPanel>
                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                   ToolTip="ログ採取（Cisco 機器へ入って show を集める）・showコマンド整形（出力を CSV に）・Meraki（ダッシュボード API からの照会）。" />
                        <TextBlock Style="{StaticResource TabIntro}" Text="ネットワーク機器を相手にする道具です。左のメニューから選んでください。" />
                    </DockPanel>

                    <!-- 左の縦メニューで中身を選ぶ。項目が増えても名前を省略せずに置ける -->
                    <TabControl TabStripPlacement="Left"
                                ItemContainerStyle="{StaticResource MenuTabItem}"
                                BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <!-- メニューの列。名前が読める幅を固定で取る -->
                            <Style TargetType="TabPanel">
                                <Setter Property="Width" Value="128" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </TabControl.Resources>

            <!-- ===== 収集（Cisco 機器へ入って show の出力を集める） ===== -->
            <TabItem x:Name="CollectTab" Header="ログ採取" DataContext="{Binding Collect}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="作業前後の証跡取りを、機器 1 台ずつ手で打つ代わりに一括で済ませられます。「宛先リストから選ぶ」で Ping / TCP に登録した相手を取り込めます（備考も一緒に入ります）。覚えるのはユーザー名だけです。パスワードと enable パスワードは保存しません。危ないコマンド（reload・configure terminal・write など）は実行前に弾きます。機器が確認を求めてくるため自動では答えられず、投げても止まるだけだからです。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Cisco 機器へ入って show の出力を自動で集め、1 台 1 ファイルに保存します。" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="宛先リストから選ぶ" Command="{Binding ImportFromTargetsCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,16,2"
                                    ToolTip="Ping と TCP のタブに登録してある宛先から、取り込む相手を選びます。" />

                            <!-- 機種。コマンド欄の上に置いていたが窓が狭いと目に入らないので、
                                 他の設定と同じこの行へ出す -->
                            <TextBlock Text="機種" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <ComboBox Width="120" Margin="0,0,16,2"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      ToolTip="選ぶとコマンド欄をその機種のおすすめで置き換えます。既定は IOS / IOS-XE です。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="接続の待ち" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,4,2" />
                            <TextBox Width="40" Text="{Binding ConnectSeconds}" Margin="0,0,2,2"
                                     ToolTip="機器につながるまで待つ時間です。この時間を過ぎたら、その機器は諦めて次へ進みます。" />
                            <TextBlock Text="秒" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,12,2" />

                            <TextBlock Text="応答の待ち" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,4,2" />
                            <TextBox Width="40" Text="{Binding IdleSeconds}" Margin="0,0,2,2"
                                     ToolTip="コマンドを送った後、出力が途切れてから諦めるまでの時間です。長い show でも出力が続いている間は待ち続けます。" />
                            <TextBlock Text="秒" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,16,2" />

                            <Button Content="収集を開始" Command="{Binding StartCommand}" Margin="0,0,6,2" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                            <Button Content="保存先を開く" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Warn.Fg}"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <DockPanel>
                            <!-- 上: 機器（1 台 1 行の表。書式を人に覚えてもらわない） -->
                            <Border DockPanel.Dock="Top" MaxHeight="300"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <!-- 見出し。どの欄に何を入れるかはここで示す -->
                                    <Grid DockPanel.Dock="Top" Margin="4,0,18,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.0]}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.2]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.3]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.4]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.5]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.6]}" />
                                            <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.7]}" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <Border Grid.Column="6" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="0" Text="削除" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="機器のアドレス" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="接続方法" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="3" Text="ユーザー名" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="4" Text="パスワード" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="5" Text="enable" Style="{StaticResource Caption}"
                                                   ToolTip="特権モードに入るためのパスワード。要らない機器は空のままで構いません。" />
                                        <TextBlock Grid.Column="6" Text="備考" Style="{StaticResource Caption}"
                                                   ToolTip="宛先リストから取り込むと、宛先に書いてある備考がそのまま入ります。" />
                                        <TextBlock Grid.Column="7" Text="状態" Style="{StaticResource Caption}" />

                                        <!-- 列幅のつまみ。星列(1)より左は右端、右は左端の境界に置く -->
                                        <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                               Tag="collect.0" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.2" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.3" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.4" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.5" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.6" DragDelta="OnTableColumnResize" />
                                        <Thumb Grid.Column="7" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                               Tag="collect.7" DragDelta="OnTableColumnResize" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1"
                                            Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                    <!--
                                        この一覧だけ仮想化を切る。行コンテナを使い回すと、
                                        PasswordBox はバインドを持たないので DataContext が変わっても
                                        中身が入れ替わらず、スクロールしただけで別の機器の欄に
                                        前の機器のパスワードが載る(そのまま送信されうる)。
                                        機器は多くても数十台なので実害は無い。
                                    -->
                                    <!--
                                        「行を追加」を先に下端へ留めてから、一覧に残りを埋めさせる。
                                        逆にして一覧を先に置くと、行が増えたときに一覧が高さを
                                        取り切ってボタンのぶんが残らず、押せなくなる(実際に起きた)。
                                        枠は中身なりの高さになるので、行が少ないときは
                                        ボタンが最後の行のすぐ下に来る。
                                    -->
                                    <Button x:Name="CollectAddRow" DockPanel.Dock="Bottom" Content="＋ 行を追加"
                                            Command="{Binding AddDeviceCommand}"
                                            Style="{StaticResource Button.Subtle}"
                                            HorizontalAlignment="Left"
                                            Margin="4,4,0,0" />

                                    <ListBox ItemsSource="{Binding Rows}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ItemContainerStyle="{StaticResource PlainRowContainer}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.0]}" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.2]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.3]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.4]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.5]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.6]}" />
                                                        <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[collect.7]}" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                    <Border Grid.Column="6" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                                    <!-- 行そのものを引数で渡す(どの行の × かを VM に伝える) -->
                                                    <Button Grid.Column="0" Content="✕"
                                                            Style="{StaticResource Button.Subtle}"
                                                            Command="{Binding DataContext.RemoveDeviceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Width="16" Height="16"
                                                            Padding="0" MinWidth="0" MinHeight="0"
                                                            FontSize="{DynamicResource Size.Micro}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center" Margin="2,0,0,0"
                                                            ToolTip="この行を消します。" />

                                                    <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="{DynamicResource Font.Mono}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="機器の IP かホスト名。" />

                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding Methods}"
                                                              SelectedItem="{Binding Method}"
                                                              FontSize="{DynamicResource Size.Caption}"
                                                              VerticalAlignment="Center" Margin="0,0,4,0"
                                                              ToolTip="つなぎ方。ポートは方式に応じて 22 / 23 を使います。">
                                                        <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBox Grid.Column="3" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="ログインするユーザー名。次回も覚えています。" />

                                                    <PasswordBox Grid.Column="4" Tag="login"
                                                                 PasswordChanged="OnCollectPasswordChanged"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"
                                                                 ToolTip="ログインのパスワード。保存しません（毎回入力）。" />

                                                    <PasswordBox Grid.Column="5" Tag="enable"
                                                                 PasswordChanged="OnCollectPasswordChanged"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"
                                                                 ToolTip="enable のパスワード。要らない機器は空のままで構いません。" />

                                                    <TextBox Grid.Column="6" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="{DynamicResource Size.Caption}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                             ToolTip="機器の覚え書き。集めたファイルの先頭にも書き出されます。" />

                                                    <TextBlock Grid.Column="7" Text="{Binding Status}"
                                                               FontSize="{DynamicResource Size.Caption}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Status}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- 下: コマンド。窓が狭いと横並びでは入りきらないので縦に積む -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,3"
                                           Text="{Binding CommandSummary}" Style="{StaticResource Caption}" />

                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding BlockedCommands}"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource Brush.Warn.Fg}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox Text="{Binding CommandText, UpdateSourceTrigger=LostFocus}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Size.Caption}"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         ToolTip="1 行 1 コマンド。打つ順に並べます。" />
                            </DockPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== パース(Cisco コマンド出力 → CSV) ===== -->
            <TabItem Header="showコマンド整形" DataContext="{Binding Converter}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                       ToolTip="対応は show ip route / ip interface brief / cdp neighbors / mac address-table / interfaces status / inventory / version / logging の 8 種。種類は自動で判定します。BOM 付き UTF-8 で保存するので、日本語版 Excel でそのまま開けます。" />
                            <TextBlock Style="{StaticResource TabIntro}" Text="Cisco コマンドの出力を貼り付けると CSV に変換します。" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="種別" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="180"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode}"
                                      Margin="0,0,12,0"
                                      ToolTip="貼り付けたコマンドの種類。自動判定で決まらないときはここで選びます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かないので ItemTemplate を明示する -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="CSV で保存" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                            <Button Content="コピー" Command="{Binding CopyCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0"
                                    ToolTip="CSV テキストをクリップボードへコピーします。" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 貼り付け欄。Cisco の出力は長いので折り返さず横スクロール -->
                            <TextBox Grid.Row="0"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="{DynamicResource Size.Caption}"
                                     AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     ToolTip="show ip route / show interfaces status などの出力をそのまま貼り付けます。" />

                            <TextBlock Grid.Row="1" Text="CSV プレビュー" Style="{StaticResource Caption}" Margin="0,6,0,3" />

                            <TextBox Grid.Row="2"
                                     Text="{Binding Preview, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="{DynamicResource Size.Caption}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Meraki(ダッシュボード API からの照会) ===== -->
            <TabItem x:Name="MerakiTab" Header="Meraki" DataContext="{Binding Meraki}">
                <DockPanel>
                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                   ToolTip="ネットワーク / 機器（シリアル・ファーム）/ MX のアップリンクとグローバル IP / クライアント。各一覧は CSV で保存できます。API キーは保存しません（毎回入力・伏せ字）。画面の PNG 保存にも、管理者として再起動するときの引き継ぎにも残しません。このタブを開いただけでは通信しません。キーを入れて押したときだけ取りに行きます。" />
                        <TextBlock Style="{StaticResource TabIntro}" Text="Meraki ダッシュボードの API から、機器やアップリンクの状況を取ります。" />
                    </DockPanel>

                    <!-- 操作行はサブタブ共通。API キーは伏せ字(画面を PNG 保存できるため) -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,2,0,6">
                        <WrapPanel>
                            <TextBlock Text="API キー" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <PasswordBox x:Name="MerakiKeyBox" Width="230" Margin="0,0,12,2"
                                         PasswordChanged="OnMerakiKeyChanged"
                                         ToolTip="ダッシュボードの [My profile] で発行したキー。保存しません。" />

                            <TextBlock Text="組織" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,2" />
                            <ComboBox Width="180" Margin="0,0,12,2"
                                      ItemsSource="{Binding Organizations}"
                                      SelectedItem="{Binding SelectedOrganization}"
                                      ToolTip="組織が複数あるときに選びます。">
                                <!-- 閉じているときの表示に DisplayMemberPath は効かない -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="取得" Command="{Binding FetchCommand}" Margin="0,0,6,2" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,0,2" />
                        </WrapPanel>

                        <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource Brush.Warn.Fg}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <TabControl x:Name="MerakiSubTabs" ItemContainerStyle="{StaticResource SubTabItem}"
                                BorderThickness="0" Padding="0">

                        <!-- ネットワーク -->
                        <TabItem Header="ネットワーク">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <!-- この画面が何をするものか。詳しい話は ⓘ の ToolTip へ -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabInfoMark}"
                                                   ToolTip="組織の中のネットワーク（拠点）を一覧にします。ここで選んだネットワークが、機器・アップリンク・クライアントの照会先になります。まずここから選んでください。20 ページで打ち切り、打ち切ったときはその旨を画面に出します（黙って切ると「その拠点は無い」と誤読されるため）。" />
                                        <TextBlock Style="{StaticResource TabIntro}" Text="組織の中のネットワーク一覧です。" />
                                    </DockPanel>

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="CSV で保存" Command="{Binding SaveNetworksCommand}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="4,0,18,3" Background="Transparent" Tag="mnet" MouseLeftButtonDown="OnTableHeaderSort">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.1]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.2]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.3]}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.4]}" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="0" Text="ネットワーク" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="ID" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="2" Text="製品" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="3" Text="タイムゾーン" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="4" Text="タグ" Style="{StaticResource Caption}" />
                                                <!-- 列幅のつまみ。星列より左は右端、右は左端の境界に置く -->
                                                <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mnet.1" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mnet.2" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mnet.3" DragDelta="OnTableColumnResize" />
                                                <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                                       Tag="mnet.4" DragDelta="OnTableColumnResize" />
                                            </Grid>
                                            <Border DockPanel.Dock="Top" Height="1"
                                                    Background="{DynamicResource Brush.Border}" Margin="0,0,0,3" />

                                            <ListBox ItemsSource="{Binding NetworkRows}"
                                                     ItemContainerStyle="{StaticResource PlainRowContainer}"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="22">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.1]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.2]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.3]}" />
                                                                <ColumnDefinition Width="{Binding Source={x:Static vm:TableColumns.Instance}, Path=[mnet.4]}" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- 列の縦罫線。文字より先に置いて背面に敷く(当たり判定は持たせない) -->
                                                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Id}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ProductTypes}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{Binding TimeZone}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Tags}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <!-- 機器 -->
                        <TabItem Header="機器">

<Window x:Class="PingWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PingWatcher.App.Controls"
        xmlns:vm="clr-namespace:PingWatcher.App.ViewModels"
        xmlns:net="clr-namespace:PingWatcher.Core.Net;assembly=PingWatcher.Core"
        Title="PingWatcher"
        Width="740" Height="720"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Backdrop}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            タブの中のサブタブ用（FTP タブの FTP/TFTP/SFTP など）。
            主タブと明確に見分けられるよう、小さめのセグメント（連結ボタン）風にする。
            選択中はアクセント地、非選択はくすませて「これは中の切り替え」と分かる形に。
        -->
        <Style x:Key="SubTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 文字は常に本文色（ダークではほぼ白）。選択中に淡い水色にすると沈んで読みづらい -->
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- 寸法はメインタブ(Padding 6,2・Size.Caption)と揃える -->
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Margin="0,0,-1,0"
                                Padding="6,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontSize="{DynamicResource Size.Caption}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 値の表示欄。読み取り専用の TextBox にして、選択してコピーできるようにする -->
        <Style x:Key="CopyableValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!--
            Ping 一覧の列幅。以前は列見出しと行テンプレートの両方に同じ数字を
            書いていて、片方だけ直すとずれた。幅の出どころをここ 1 か所にする。

            StaticResource なのは、実行中に変わらない値だから。DynamicResource に
            すると仮想化された行を作り直すたびに解決が走る。前方参照はできないので、
            使う側より前に置くこと。
        -->
        <!-- 一覧 1 行。列幅は上の定義を見出しと共有している -->
        <DataTemplate x:Key="TargetRowTemplate">
            <Grid Height="{DynamicResource Size.RowHeight}">
                <!-- 幅はヘッダと共有(ColumnLayout)。ヘッダの境目をドラッグすると全行が追随する。
                     備考は宛先の右隣(ユーザー指示)の可変幅で、余った幅を吸収する。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target}" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark}" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge"
                        Grid.Column="0"
                        Style="{StaticResource Badge}"
                        Background="{DynamicResource Brush.Info.Bg}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText"
                               Style="{StaticResource Badge.Text}"
                               Foreground="{DynamicResource Brush.Info.Fg}"
                               Text="◌ 待機" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding HostDisplay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding HostDisplay}" />

                <TextBlock Grid.Column="2" Text="{Binding Comment}"
                           Style="{StaticResource Caption}"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Comment}" />

                <TextBlock Grid.Column="3" Text="{Binding LatestRtt}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Column="4" Text="{Binding Loss}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <controls:Sparkline Grid.Column="5" Source="{Binding}" Margin="8,3,8,3"
                                    LineBrush="{DynamicResource Brush.Chart.Line}"
                                    LostBrush="{DynamicResource Brush.Error.Fg}" />

                <!-- 列の区切り線。行の区切り線と同じ淡さの縦線で、境目を目で追えるようにする -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="● 応答" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="✕ 不通" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Refused">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="⊘ 拒否" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unresolved">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="? 名前" />
                </DataTrigger>
                <!-- 測定が止まっている状態。不達と取り違えると確認ツールとして嘘になる -->
                <DataTrigger Binding="{Binding State}" Value="Stalled">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="… 停止" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            右クリックメニューを持たない行コンテナ。
            スキャン結果・周辺 AP・作業比較・差分比較の一覧はこちらを使う。
            メニュー付きのコンテナを流用すると、DataContext の型が違うため
            「経路を調べる」などを押しても無反応のメニューが出てしまう。
        -->
        <Style x:Key="PlainRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上の枠付き版。差分比較の一覧が使う（選択を枠で示す） -->
        <Style x:Key="PlainCompactContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Sel"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Margin="0,0,3,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行コンテナ。選択の見た目だけ差し替え、既定の青い選択色は使わない -->
        <Style x:Key="TargetRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="経路を調べる" Click="OnTraceFromRow" />
                                    <MenuItem Header="名前を引く" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="宛先名をコピー" Click="OnCopyHostFromRow" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            応答なし欄用の行コンテナ。選択はアクセントの緑ではなく赤系で示す。
            赤いカードの中で選択行だけ緑に光ると、状態が変わったように見えてしまう。
        -->
        <Style x:Key="DownRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 下辺だけ淡い線を引き、詰めた行の境目を示す(選択枠の透明ボーダーは持たない) -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Row.Line}"
                                Padding="{TemplateBinding Padding}">
                            <!--
                                右クリックの行き先。イベントの結線はテンプレートの中でしか当てにできない。
                                Style の Setter へ直接 ContextMenu を置くと、リソースが後から
                                展開される都合で結線がずれ、起動時に落ちる（自己診断で実証済み）。

                                メニューは論理ツリーが切れているので、PlacementTarget 経由で
                                右クリックした行そのものを DataContext にする。
                                選択は動かさない（左クリックの挙動は今まで通り）。
                            -->
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                           RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="経路を調べる" Click="OnTraceFromRow" />
                                    <MenuItem Header="名前を引く" Click="OnResolveFromRow" />
                                    <Separator />
                                    <MenuItem Header="アドレスをコピー" Click="OnCopyAddressFromRow" />
                                    <MenuItem Header="宛先名をコピー" Click="OnCopyHostFromRow" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <!-- 面を一段持ち上げて示す(緑のアクセントは使わない) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            1 行 1 件の一覧（仮想化必須）。
            参照するテンプレートより後に置くこと（StaticResource は前方参照できない）。
        -->
        <!--
            機器を選ぶ札。タブと同じ見た目にして「押して切り替えるもの」と分かるようにする。
            選択中はアクセント色で塗り、貼り付け済みの数を添える。
        -->
        <Style x:Key="DeviceChip" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 寸法はメインタブ(Padding 6,2・Size.Caption・間隔 2)と揃える -->
            <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="6,2"
                                Margin="0,0,2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TargetListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!--
                仮想化の指定は ListBox 側に付ける。VirtualizingStackPanel は自分の
                属性ではなく ItemsControl 側の添付プロパティを読むため、パネル要素に
                書いた VirtualizationMode は参照されず、Recycling が効かないまま
                コンテナが使い捨てで生成され続ける。
            -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate" Value="{StaticResource TargetRowTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TargetRowContainer}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6,5,6,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダ ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,5">
            <TextBlock Text="PingWatcher"
                       FontSize="{DynamicResource Size.Title}"
                       Margin="0,0,14,0" VerticalAlignment="Center" />

            <!--
                測定の開始と停止はここに置く。どのタブを見ていても押せるように。
                宛先を書き換えている最中や、機器の出力を見比べている最中に
                止めたくなることが多い。
            -->
            <StackPanel Orientation="Horizontal" DataContext="{Binding Monitor}">
                <Button Content="{Binding RunButtonLabel}" Command="{Binding StartCommand}"
                        Click="OnStartClicked" Margin="0,0,5,0" />
                <Button Content="停止" Command="{Binding StopCommand}"
                        Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />

                <!--
                    件数はここに出さない。宛先タブと一覧の見出しに出ているうえ、
                    実行中かどうかはボタンの文字で分かる。
                    ここに残すのは、伝えないと困ること（失敗など）だけにする。
                -->
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
            </StackPanel>

            <!--
                消す範囲を選ばせる。測り直したいだけのときに、作業前の記録や
                機器の貼り付けまで巻き添えにするのは行き過ぎなので分けている。

                メニューはボタンに直接付けている。Style の Setter に置くと
                イベントの結線がずれて起動時に落ちる（CLAUDE.md 参照）。
            -->
            <Button x:Name="ClearButton" Content="クリア ▾" Click="OnClearMenu"
                    Style="{StaticResource Button.Subtle}"
                    Margin="0,0,8,0"
                    ToolTip="消す範囲を選びます。">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ping の測定結果だけ消す" Click="OnClearPingResults" />
                        <Separator />
                        <MenuItem Header="すべて消す（起動直後に戻す）" Click="OnClearAll" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- 画面の証跡。ウィンドウの中身を PNG にして logs フォルダへ残す -->
            <Button x:Name="ScreenshotButton" Content="📷 画面" Click="OnScreenshot"
                    Style="{StaticResource Button.Icon}"
                    Margin="0,0,8,0"
                    MinWidth="86"
                    AutomationProperties.Name="画面を撮って保存"
                    ToolTip="いまの画面を PNG で logs フォルダに保存します。" />

            <!-- 配色の切り替え。記号だけだと意味が伝わらないので文字も添える -->
            <Button x:Name="ThemeToggle" Click="OnThemeToggle"
                    Style="{StaticResource Button.Icon}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="配色の切り替え"
                    ToolTip="明るい配色と暗い配色を切り替えます。" />

            <CheckBox x:Name="TopmostToggle" Content="最前面"
                      Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      ToolTip="他のウィンドウの手前に固定します。" />
        </StackPanel>

        <!-- 操作の帯と本体を分ける罫線。1 本引くだけで画面が締まる -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{DynamicResource Brush.Border}" Margin="0,0,0,-1" />

        <!-- ===== 本体 ===== -->
        <!-- コンテンツ領域に枠と地色を持たせる(選択タブがここへ食い込んで地続きに見える)。
             Background は TabItem スタイルの選択色と同じ Brush.Surface であること -->
        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="OnTabSelectionChanged"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Padding="6">

            <!-- ===== 宛先(EXPing と同じ書き方でまとめて編集する) ===== -->
            <TabItem Header="宛先" DataContext="{Binding Monitor}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="宛先リスト" />

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="7,5" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    行頭が <Run>#</Run> <Run>;</Run> <Run>'</Run> 全角スペース の行は注釈として読み飛ばします。
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    範囲でまとめて書けます（EXPing にはない拡張）:
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.10-20</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.1-192.168.1.50</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.0/24</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="書き換えると自動で反映されます。" />
                            <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 FontSize="{DynamicResource Size.Caption}"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Ping（測定と結果の表示） ===== -->
            <TabItem x:Name="PingTab" Header="Ping" DataContext="{Binding Monitor}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 操作列。開始・停止はヘッダへ移したので、ここに残すのは
                             この画面でしか使わないものだけ -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="履歴を消去"
                                    Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Margin="0,0,12,0" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="行を右クリックすると、その宛先の経路や名前を調べられます。" />
                        </StackPanel>

                        <!-- 選択行の詳細。一覧に列を増やさずに済ませるための置き場 -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DetailText}"
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 一覧のヘッダ。両方の欄で共通なので、分割の外に出して常に最上部へ置く。
                             列幅は TargetRowTemplate と合わせること -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 左右 11px は「カード枠 1 + カード余白 6 + 行余白 4」。
                                 行側の仕切り線とヘッダの仕切り線がぴったり重なる値なので変えないこと -->
                            <Grid Margin="11,0,11,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=State, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Target, Mode=TwoWay}" MinWidth="60" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Rtt, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Loss, Mode=TwoWay}" MinWidth="36" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Instance}, Path=Spark, Mode=TwoWay}" MinWidth="60" />
                                </Grid.ColumnDefinitions>

                                <!-- クリックでソート(同じ列を再クリックで昇順→降順→元の並び)。
                                     文字だけだと当たり判定が狭いので、透明の Border で列幅いっぱいに受ける -->
                                <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="State"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderState}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Target"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderTarget}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Comment"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderNote}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rtt"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderRtt}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Loss"
                                        MouseLeftButtonDown="OnListHeaderSort"
                                        ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                    <TextBlock Text="{Binding HeaderLoss}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="5" Text="推移" Style="{StaticResource Caption}" HorizontalAlignment="Center" />

                                <!-- 列の区切り線(行側と同じ色)。スプリッタの位置の目印にもなる -->
                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Row.Line}" IsHitTestVisible="False" />

                                <!--
                                    列幅の変更。固定列の右端を掴んで動かすと、その列だけが伸縮し、
                                    余りは可変幅の備考(列 2)が吸収する。GridSplitter は使わない —
                                    あちらは「掴んだ列と隣の列」を同時に伸縮するため、RTT を広げると
                                    ロスが潰れる不自然な動きになる(ユーザー指摘)。Thumb の DragDelta で
                                    ColumnLayout の幅を直接書き、TwoWay バインドが列定義へ反映する。
                                -->
                                <Thumb Grid.Column="0" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="State" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="1" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Target" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="3" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Rtt" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="4" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Loss" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="5" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                       Tag="Spark" DragDelta="OnColumnResize" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,4" />
                        </StackPanel>

                        <!--
                            2 回続けて応答が無かった宛先を上、応答のある宛先を下に置く。
                            手当てが要るのは落ちている方なので、そちらを目の高さに持ってくる。
                        -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <!-- ===== 応答なし（2 回連続で失敗） ===== -->
                            <Border Grid.Row="0" Margin="0,0,0,7"
                                    Background="{DynamicResource Brush.Error.Bg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Error.Fg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownRows}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DockPanel MaxHeight="188">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Error.Fg}" />
                                        <TextBlock Text="{Binding DownHeader}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding DownRows}"
                                             SelectedItem="{Binding SelectedDownRow}"
                                             ItemContainerStyle="{StaticResource DownRowContainer}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>

                            <!-- ===== 応答あり =====
                                 応答なしの赤いカードと対になるよう、こちらも枠のある
                                 カードにする。枠が無いと 2 つの欄の境目が読み取れない。
                                 帯に地色は敷かない(暗い配色では地の緑が沈んで濁るため)。 -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Ok.Fg}" />
                                        <TextBlock Text="{Binding AliveHeader}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}"

                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 仮想化を効かせるため行高は固定にしている -->
                                    <ListBox ItemsSource="{Binding AliveRows}"
                                             SelectedItem="{Binding SelectedAliveRow}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 経路 ===== -->
            <TabItem x:Name="TraceTab" Header="経路" DataContext="{Binding Trace}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 起動幅では 1 行ぎりぎりなので折り返せるようにしておく -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <TextBlock Text="宛先" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,2" />
                            <TextBox Width="240"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,2" />
                            <Button Content="経路を調べる" Command="{Binding TraceCommand}" Margin="0,0,6,2" />
                            <Button Content="MTU を調べる" Command="{Binding MtuCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                    ToolTip="経路上で分割せずに通る最大パケットサイズを二分探索で求めます。" />
                            <Button Content="中断" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,10,2" />
                            <CheckBox Content="60秒ごとに見張る" IsChecked="{Binding IsWatching}"
                                      VerticalAlignment="Center" Margin="0,0,10,2"
                                      ToolTip="定期的に経路を調べ直し、変わったら下に記録します。" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>

                        <!-- 経路が変わった記録 -->
                        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" MaxHeight="96"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- 変化が 1 件も無いうちは場所を取らない -->
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="何が変わったか" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Changes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MtuText}"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="4,6,0,0" />

                        <Grid DockPanel.Dock="Top" Margin="4,0,4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"      Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="IP"     Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="ホスト名" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="RTT"    Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="状態"   Style="{StaticResource Caption}" Margin="10,0,0,0" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Hops}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="{DynamicResource Radius.Badge}" Padding="4,0">
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" MinWidth="140" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="TtlText" Grid.Column="0" Text="{Binding Ttl}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AddressText" Grid.Column="1" Text="{Binding Address}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding HostName}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Rtt}"
                                                           Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Note}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <!-- 応答が無かったホップは沈める -->
                                            <DataTrigger Binding="{Binding Responded}" Value="False">
                                                <Setter TargetName="AddressText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Setter TargetName="TtlText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                            <!-- 宛先に届いた行を目立たせる -->
                                            <DataTrigger Binding="{Binding IsDestination}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                <Setter TargetName="AddressText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                                <Setter TargetName="AddressText" Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 無線 ===== -->
            <TabItem x:Name="WifiTab" Header="無線" DataContext="{Binding Wifi}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <!-- SSID が長い環境でボタンが押し出されないよう幅を抑える -->
                                <TextBlock Text="{Binding ConnectionSummary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           MaxWidth="280" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ConnectionSummary}" />
                                <Button Content="更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                                <Button Content="保存" Command="{Binding SaveCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,10,0"
                                        ToolTip="いまの接続情報と周辺 AP の一覧をテキストで保存します。" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 位置情報が許可されていないときの案内 -->
                            <Border Background="{DynamicResource Brush.Warn.Bg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,5,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource Brush.Warn.Fg}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="Windows 11 24H2 以降、無線 LAN の情報を読むには位置情報の許可が必要です。設定で「位置情報」を有効にしてから、もう一度お試しください。" />
                                    <Button Content="設定を開く" Command="{Binding OpenLocationSettingsCommand}"
                                            Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 接続中 AP の詳細と RSSI 推移 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Ssid}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="信号" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Signal}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BSSID" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bssid}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="チャンネル" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Channel}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="機器" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="規格" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PhyType}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="暗号化" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Security}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="リンク速度" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LinkRate}"
                                               ToolTip="ネゴシエートされたリンク速度です。実際の通信速度ではありません。" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="アダプタ" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Adapter}"
                                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="5,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="受信強度の推移（dBm・直近2分）"
                                               Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <!-- 読み方の目安。-67 dBm が通話・会議の実用下限としてよく使われる -->
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="目安: -50 以上 非常に良い ／ -60 良い ／ -67 実用圏（通話・会議はここまで） ／ -75 弱い ／ それ未満 不安定" />
                                    <controls:RssiChart Source="{Binding}" MinHeight="86" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- チャンネル混雑 -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="7,5" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="チャンネルの混み具合（そのチャンネルを使っている AP の数）"
                                           Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <ItemsControl ItemsSource="{Binding Channels24}" Height="76" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="22">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar" Width="14" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Accent.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="2.4 GHz" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Channels5}" Height="76" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Width="30">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" />
                                                        <Border x:Name="Bar5" Width="18" Height="{Binding Height}"
                                                                Background="{DynamicResource Brush.Info.Bg}"
                                                                CornerRadius="0"
                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter TargetName="Bar5" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="5 GHz 以上" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 周辺 AP 一覧 -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <!-- クリックでソート(昇順→降順→強い順)。透明 Border で列幅いっぱいに受ける -->
                            <Border Grid.Column="0" Background="Transparent" Cursor="Hand" Tag="Ssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderSsid}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Tag="Bssid"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBssid}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Tag="Vendor"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderVendor}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Tag="Rssi"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderRssi}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="4" Background="Transparent" Cursor="Hand" Tag="Channel"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderChannel}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="5" Background="Transparent" Cursor="Hand" Tag="Band"
                                    MouseLeftButtonDown="OnListHeaderSort"
                                    ToolTip="クリックで並べ替え（もう一度で逆順、三度目で元の並び）">
                                <TextBlock Text="{Binding HeaderBand}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ListBox ItemsSource="{Binding AccessPoints}"
                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{DynamicResource Size.RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="SsidText" Grid.Column="0" Text="{Binding Ssid}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Bssid}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Vendor}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rssi}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Channel}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding Band}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter TargetName="SsidText" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="SsidText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 差分比較（show ip route / show run を作業前後で見比べる） ===== -->
            <TabItem Header="差分比較" DataContext="{Binding DeviceCompare}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">

                            <!--
                                機器の並び。1 回の作業で何台も設定変更することがあるので、
                                台数ぶん並べて作業前をまとめて集められるようにしている。
                            -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="削除"
                                        Command="{Binding RemoveDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="4,0,0,0"
                                        ToolTip="選んでいる機器を、貼り付けごと削除します。" />
                                <Button DockPanel.Dock="Right" Content="＋ 機器"
                                        Command="{Binding AddDeviceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="8,0,0,0"
                                        ToolTip="比較する機器を増やします。" />
                                <TextBox DockPanel.Dock="Right" Width="150"
                                         Text="{Binding SelectedDevice.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0" VerticalAlignment="Center"
                                         ToolTip="機器名。ホスト名を入れておくと記録を見返すときに分かります。" />
                                <TextBlock DockPanel.Dock="Right" Text="名前" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />

                                <ListBox ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice}"
                                         ItemContainerStyle="{StaticResource DeviceChip}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- 起動幅(740px)では 1 行に収まらないので折り返す -->
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="対象" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <!--
                                    DisplayMemberPath は使わない。閉じているときの表示は
                                    SelectionBoxItemTemplate 経由で描かれるため、テンプレートを
                                    明示しないと選択中の項目が型名のまま出てしまう。
                                -->
                                <ComboBox Width="230" ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding SelectedMode}" Margin="0,0,10,0"
                                          ToolTip="対象ごとに貼り付けた内容は保たれます。作業前にまとめて貼っておけます。">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding StateMark, Mode=OneWay}"
                                                     Foreground="{DynamicResource Brush.Info.Fg}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="比較" Command="{Binding CompareCommand}" Margin="0,0,6,2" />
                                <Button Content="比較を停止" Command="{Binding EditCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2"
                                        ToolTip="比較をやめて貼り付け欄に戻ります。貼り付けた内容は残ります。" />
                                <CheckBox Content="異なる行だけ" IsChecked="{Binding OnlyDifferences}"
                                          VerticalAlignment="Center" Margin="0,0,12,2" />

                                <!-- 差分をたどる。長い設定では目で探すのが現実的でない -->
                                <Button Content="◀ 前の差分" Command="{Binding PreviousDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,4,2"
                                        ToolTip="前の差分へ移ります。先頭まで来たら末尾へ回ります。" />
                                <Button Content="次の差分 ▶" Command="{Binding NextDifferenceCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,8,2"
                                        ToolTip="次の差分へ移ります。末尾まで来たら先頭へ回ります。" />
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>

                            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <!-- どの対象を貼り終えたか。作業前の取りこぼしに気づけるように -->
                            <TextBlock Text="{Binding PastedSummary}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Fg}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 読むときの注意。Style は属性と要素の両方には書けないので、
                                 見た目もまとめてここで指定する -->
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <!--
                            貼り付け欄と結果は同じ場所に重ねる。
                            DockPanel は最後の子だけが残りを埋めるので、この入れ物を最後に置かないと
                            貼り付け欄が中身の高さまで縮んでしまう（show run を貼るには狭すぎた）。
                        -->
                        <Grid>
                            <!-- 貼り付け欄 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,5,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業前" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="保存" Command="{Binding SaveBeforeCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180" />
                                </DockPanel>

                                <DockPanel Grid.Column="1" Margin="5,0,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="作業後" VerticalAlignment="Center" />
                                        <Button Content="ファイルから" Command="{Binding LoadAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="10,0,0,0" />
                                        <Button Content="保存" Command="{Binding SaveAfterCommand}"
                                                Style="{StaticResource Button.Subtle}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="{DynamicResource Size.Caption}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" MinHeight="180" />
                                </DockPanel>
                            </Grid>

                            <!-- 結果 -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <!-- 経路として見た変化。行の差分より先に見てほしい -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,5" Padding="7,5"
                                        Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Card}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStructuredView}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel MaxHeight="180">
                                        <TextBlock DockPanel.Dock="Top" Text="何が変わったか"
 Margin="0,0,0,4" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="ChangeText" Text="{Binding Description}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                                <Setter TargetName="ChangeText" Property="FontWeight" Value="Normal" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- 左右の見出し -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="作業前" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="作業後" Style="{StaticResource Caption}" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1"
                                        Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                                <!-- 左右並置。1 つのスクロールに収めるので、左右がずれない -->
                                <ListBox x:Name="DiffList"
                                         ItemsSource="{Binding Rows}"
                                         ItemContainerStyle="{StaticResource PlainCompactContainer}"
                                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding LeftNumberText}"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Right" Margin="0,0,6,0" />

                                                <!-- 行の中の違う箇所だけ地色を変える(WinMerge の行内色分け)。
                                                     消えた側は Error.Bg、増えた側は Ok.Bg — 行全体の色と同じ語彙 -->
                                                <Border x:Name="LeftCell" Grid.Column="1" Padding="4,1" CornerRadius="{DynamicResource Radius.Chip}" Margin="0,0,6,0">
                                                    <controls:DiffText Segments="{Binding LeftSegments}"
                                                                       ChangedBrush="{DynamicResource Brush.Error.Bg}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       TextWrapping="NoWrap" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding RightNumberText}"
                                                           Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Right" Margin="0,0,6,0" />

                                                <Border x:Name="RightCell" Grid.Column="3" Padding="4,1" CornerRadius="{DynamicResource Radius.Chip}">
                                                    <controls:DiffText Segments="{Binding RightSegments}"
                                                                       ChangedBrush="{DynamicResource Brush.Ok.Bg}"
                                                                       Style="{StaticResource Mono}"
                                                                       FontSize="{DynamicResource Size.Caption}"
                                                                       TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                                                    <Setter TargetName="LeftCell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                                                    <Setter TargetName="RightCell" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="LeftOnly">
                                                    <Setter TargetName="LeftCell" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="RightOnly">
                                                    <Setter TargetName="RightCell" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== スキャン ===== -->
            <TabItem Header="スキャン" DataContext="{Binding Scan}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <!-- 起動幅では 1 行に収まらないので折り返す -->
                            <WrapPanel>
                                <TextBlock Text="範囲" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,2" />
                                <TextBox Width="260"
                                         Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         Margin="0,0,8,2" />
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,12,2" />
                                <CheckBox Content="ホスト名を引く" IsChecked="{Binding ResolveNames}"
                                          VerticalAlignment="Center" Margin="0,0,12,2" />
                                <CheckBox Content="ポートも調べる" IsChecked="{Binding ScanPorts}"
                                          VerticalAlignment="Center" Margin="0,0,12,2"
                                          ToolTip="よく使う22ポートだけを調べます。ウイルス対策ソフトが反応する場合があります。" />
                                <Button Content="スキャン" Command="{Binding ScanCommand}" Margin="0,0,6,2" />
                                <Button Content="中断" Command="{Binding CancelCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                <Button Content="宛先に追加" Command="{Binding AddToTargetsCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,6,2" />
                                <Button Content="CSV で保存" Command="{Binding SaveCommand}"
                                        Style="{StaticResource Button.Subtle}" Margin="0,0,0,2"
                                        ToolTip="スキャン結果(IP・RTT・ホスト名・MAC・ベンダー・開放ポート)を CSV に保存します。" />
                            </WrapPanel>

                            <!-- RangeBase.Value は既定が TwoWay。読み取り専用プロパティに繋ぐので OneWay を明示する -->
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,5,0,0" />

                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 一覧のヘッダ -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IP"       Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="RTT"      Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="ホスト名" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="3" Text="MAC"      Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="ベンダー" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="開放ポート" Style="{StaticResource Caption}" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <ListBox ItemsSource="{Binding Results}"
                                 ItemContainerStyle="{StaticResource PlainRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="{DynamicResource Size.RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Rtt}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding HostName}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Mac}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Vendor}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding Ports}"
                                                   Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== TCP（接続できるかで測る。ICMP が塞がれている相手向け） ===== -->
            <TabItem Header="TCP" DataContext="{Binding Tcp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 操作 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                            <Button Content="{Binding RunButtonLabel}" Command="{Binding StartCommand}"
                        Click="OnStartClicked" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,10,0" />

                            <TextBlock Text="既定ポート" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="56" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     ToolTip="宛先に :ポート が書いていないときに使うポート。" />

                            <Button Content="履歴を消去" Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 宛先。Ping とは別に持つ -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,5"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="7,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="1 行に 1 宛先。末尾の :ポート が測る先です（例 srv-01:445）。省略すると上の既定ポートを使います。書き換えると自動で反映されます。" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListSummary}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="86" Margin="0,4,0,0"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource Size.Caption}"
                                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top" />
                            </DockPanel>
                        </Border>

                        <!-- 選んだ行の詳しい統計 -->
                        <Border DockPanel.Dock="Bottom" Margin="0,5,0,0"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="8,5">
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 結果。Ping と同じく、つながらない方を上に置く -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,7"
                                    Background="{DynamicResource Brush.Error.Bg}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Error.Fg}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownRows}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <DockPanel MaxHeight="188">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Error.Fg}" />
                                        <TextBlock Text="{Binding DownHeader}"
                                                   Foreground="{DynamicResource Brush.Error.Fg}"
 VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding DownRows}"
                                             SelectedItem="{Binding SelectedDownRow}"
                                             ItemContainerStyle="{StaticResource DownRowContainer}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>

                            <!-- 応答なしの赤いカードと対になる枠。境目をはっきりさせる -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="1,0,0,4">
                                        <Border Width="3" CornerRadius="0" Margin="0,1,6,1"
                                                Background="{DynamicResource Brush.Ok.Fg}" />
                                        <TextBlock Text="{Binding AliveHeader}"
                                                   Foreground="{DynamicResource Brush.Ok.Fg}"
 VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding AliveRows}"
                                             SelectedItem="{Binding SelectedAliveRow}"
                                             Style="{StaticResource TargetListBox}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== TFP（FTP / TFTP / SFTP をまとめたファイル配布サーバ） ===== -->
            <TabItem Header="FTP">
                <DockPanel>
                    <!-- 中の切り替えであることを見出しで明示する -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,0,6">
                        <TextBlock Text="プロトコル" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    </StackPanel>

                    <TabControl ItemContainerStyle="{StaticResource SubTabItem}" BorderThickness="0" Padding="0">

            <!-- FTP: 機器の config バックアップ受け・平文 -->
            <TabItem Header="FTP" DataContext="{Binding Ftp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{Binding RunLabel}" Command="{Binding StartCommand}" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <TextBlock Text="ポート" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="56" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     HorizontalContentAlignment="Center" Margin="0,0,12,0"
                                     ToolTip="標準は 21。使えないときは 2121 などを試してください。" />
                            <TextBlock Text="ユーザー" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"
                                     ToolTip="空欄なら誰でも接続できます（anonymous）。" />
                            <TextBlock Text="パス" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0" />
                            <Button Content="フォルダを開く" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="9,6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="機器から受け取ったファイルは、exe と同じ場所の ftp フォルダに入ります。機器側では次のように打ちます。" />
                                <TextBox Style="{StaticResource CopyableValue}" Text="{Binding CommandHint, Mode=OneWay}"
                                         Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.Warn.Fg}"
                                           Text="⚠ 通信は暗号化されません（平文）。使うときだけ開始し、終わったら停止してください。初回はWindowsのファイアウォールでこのPCの通信を許可する必要があります。" />
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="転送の記録" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Log}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- TFTP: 認証なし・UDP -->
            <TabItem Header="TFTP" DataContext="{Binding Tftp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{Binding RunLabel}" Command="{Binding StartCommand}" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <TextBlock Text="ポート" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="56" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     HorizontalContentAlignment="Center" Margin="0,0,12,0"
                                     ToolTip="標準は 69。" />
                            <Button Content="フォルダを開く" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="9,6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="機器とやり取りしたファイルは、exe と同じ場所の tftp フォルダに入ります。機器側では次のように打ちます。" />
                                <TextBox Style="{StaticResource CopyableValue}" Text="{Binding CommandHint, Mode=OneWay}"
                                         Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.Warn.Fg}"
                                           Text="⚠ TFTP は認証も暗号化もありません。使うときだけ開始し、終わったら停止してください。初回はWindowsのファイアウォールで許可が必要です。" />
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="転送の記録" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Log}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="{DynamicResource Size.RowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Remote}" Style="{StaticResource Mono}"
                                                           FontSize="{DynamicResource Size.Caption}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- SFTP: SSH 越しで暗号化 -->
            <TabItem Header="SFTP" DataContext="{Binding Sftp}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{Binding RunLabel}" Command="{Binding StartCommand}" Margin="0,0,5,0" />
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}" Margin="0,0,12,0" />
                            <TextBlock Text="ポート" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="56" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     HorizontalContentAlignment="Center" Margin="0,0,12,0"
                                     ToolTip="標準は 22。" />
                            <TextBlock Text="ユーザー" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"
                                     ToolTip="空欄なら認証なしで接続できます。" />
                            <TextBlock Text="パス" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="90" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0" />
                            <Button Content="フォルダを開く" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource Button.Subtle}" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}" Padding="9,6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="やり取りしたファイルは、exe と同じ場所の sftp フォルダに入ります。SSH 越しなので通信は暗号化されます。" />
                                <TextBox Style="{StaticResource CopyableValue}" Text="{Binding CommandHint, Mode=OneWay}"
                                         Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.Warn.Fg}"
                                           Text="⚠ 使うときだけ開始し、終わったら停止してください。初回はWindowsのファイアウォールで許可が必要です。ホスト鍵は初回に作られ、以後は同じものを使います。" />
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                CornerRadius="{DynamicResource Radius.Card}" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="接続の記録" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Log}"
                                         Style="{StaticResource TargetListBox}"
                                         ItemContainerStyle="{StaticResource PlainRowContainer}"

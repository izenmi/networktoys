                                                    <Setter TargetName="BodyText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter TargetName="SeverityText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                    <Setter TargetName="BodyText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>

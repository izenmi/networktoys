                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="宛先" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Width="140" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Font.Mono}" Margin="0,0,12,0"
                                                 ToolTip="機器の IP。" />
                                        <TextBlock Text="コミュニティ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Width="90" Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,12,0" />
                                        <CheckBox Content="v2c" IsChecked="{Binding IsV2c}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"

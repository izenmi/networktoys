<!--
    PingWatcher ライトテーマ。キャンディパステル。

    白に近い地へ、さくらピンク・ミント・水色・レモンを載せる。
    彩度は高めだが明度も高いので、地色として敷いても文字が沈まない。

    使い方の約束: 地色(*.Bg)と文字色(*.Fg)は必ずペアで使う。
    パステルの地に淡い文字を置くと読めなくなるため、組み合わせを崩さないこと。
    地色を敷くのは状態バッジだけにし、RTT などの数値は文字色のみで表現する。

    ブラシは po:Freeze="True" で凍結している。数百行を描画するので効く。

    テーマ切替のための約束:
    ・この辞書は ThemeManager が丸ごと差し替える。**色は必ず DynamicResource で引くこと。**
      StaticResource で引いた箇所は切り替えても古い色のまま残る。
    ・コードから TryFindResource した結果を static に**キャッシュしない**。
      Sparkline で実際にやってしまい、切替に追随しない不具合になった。
    ・Palette.Dark.xaml と**同じキーを過不足なく**定義する。ずれは自己診断が検出する。
    ・凍結ブラシは Color をアニメーションできない。演出は Opacity 側で行う。

    エラーの赤とアクセントのピンクは色相を離してある。どちらもピンク系にすると
    「異常」と「選択中」が見分けられなくなる。
    文字色と地色の組み合わせはすべてコントラスト比 4.5 以上（自己診断が検算する）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ベース。地はほんのりピンクを含んだ白 -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#FFF7FB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#FDEDF6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#F6DCEA" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#3F2A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#75596C" po:Freeze="True" />

    <!-- 状態: 応答あり(ミント) -->
    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#C6F2E0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#136B4E" po:Freeze="True" />

    <!-- 状態: 遅延・警告(レモン) -->
    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#FFE7B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#87510C" po:Freeze="True" />

    <!-- 状態: 不達・エラー(いちご) -->
    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#FFDFE3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#B92038" po:Freeze="True" />

    <!-- 状態: 実行中・情報(ソーダ) -->
    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#CDEBFC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#0F5E85" po:Freeze="True" />

    <!-- 選択・アクセント(さくら) -->
    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#FBD9EC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#B32877" po:Freeze="True" />

    <!-- グラフ描画用 -->
    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#E86BA8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#FCE3F0" po:Freeze="True" />

    <!-- 細部 -->
    <SolidColorBrush x:Key="Brush.Chip.Edge"    Color="#F7E2EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#EEC3DC" po:Freeze="True" />

    <!--
        面と枠のグラデーション。影(DropShadowEffect)は使わない。
        一覧は毎秒書き換わるので、効果を挟むと描画が破綻する。
        上辺を明るくした枠で、影の代わりの立体感を出す。
    -->
    <LinearGradientBrush x:Key="Brush.Window.Backdrop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFF9FC" />
        <GradientStop Offset="1" Color="#FDF0F7" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Face" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#FFFAFD" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Edge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FBE4F0" />
        <GradientStop Offset="1" Color="#F3D5E6" />
    </LinearGradientBrush>

    <!-- ピンクから水色へ。この 2 色の並びがこの配色の要 -->
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#F27BB8" />
        <GradientStop Offset="1" Color="#6FC8EC" />
    </LinearGradientBrush>

</ResourceDictionary>

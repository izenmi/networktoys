<!--
    PingWatcher ライトテーマ。

    地と文字は無彩色。**色を使うのはアクセントと状態バッジだけ**にして、
    緑はアクセント（タブ・ボタン・選択・グラデーション）に絞る。
    全面を緑にすると、肝心の状態の色が地に埋もれて読み取りづらくなる。

    使い方の約束: 地色(*.Bg)と文字色(*.Fg)は必ずペアで使う。
    パステルの地に淡い文字を置くと読めなくなるため、組み合わせを崩さないこと。
    地色を敷くのは状態バッジだけにし、RTT などの数値は文字色のみで表現する。

    ブラシは po:Freeze="True" で凍結している。数百行を描画するので効く。

    テーマ切替のための約束:
    ・この辞書は ThemeManager が丸ごと差し替える。**色は必ず DynamicResource で引くこと。**
      StaticResource で引いた箇所は切り替えても古い色のまま残る。
    ・コードから TryFindResource した結果を static に**キャッシュしない**。
      Sparkline で実際にやってしまい、切替に追随しない不具合になった。
    ・Palette.Dark.xaml と**同じキーを過不足なく**定義する。ずれは自己診断が検出する。
    ・凍結ブラシは Color をアニメーションできない。演出は Opacity 側で行う。

    **緑が 2 つあることに注意。** アクセントの葉緑（115°）と、応答ありのミント（165°）。
    この 50° の差を詰めると「選択中」と「応答あり」が見分けられなくなる。
    文字色と地色の組み合わせはすべてコントラスト比 4.5 以上（自己診断が検算する）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ベース。色を持たせない -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#F7F7F8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#F0F1F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#E2E3E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#232529" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#61646B" po:Freeze="True" />

    <!-- 状態: 応答あり(ミント。アクセントの葉緑とは青緑側へ離す) -->
    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#BEEFDD" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#0B6851" po:Freeze="True" />

    <!-- 状態: 遅延・警告(アプリコット) -->
    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#FFE0BE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#8F4E0C" po:Freeze="True" />

    <!-- 状態: 不達・エラー(いちご) -->
    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#FFDCE1" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#B81F39" po:Freeze="True" />

    <!-- 状態: 実行中・情報(ソーダ) -->
    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#CDE9FB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#0E5C84" po:Freeze="True" />

    <!-- 選択・アクセント(パステルの葉緑)。色を使うのはここだけ -->
    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#D2EFC7" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#2F6B2A" po:Freeze="True" />

    <!-- グラフ描画用 -->
    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#5FA455" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#E4F4DE" po:Freeze="True" />

    <!-- 細部。ここも無彩色に寄せる -->
    <SolidColorBrush x:Key="Brush.Chip.Edge"    Color="#E8E9EB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#C7C9CE" po:Freeze="True" />

    <!--
        面と枠のグラデーション。影(DropShadowEffect)は使わない。
        一覧は毎秒書き換わるので、効果を挟むと描画が破綻する。
        上辺を明るくした枠で、影の代わりの立体感を出す。
    -->
    <LinearGradientBrush x:Key="Brush.Window.Backdrop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FAFAFB" />
        <GradientStop Offset="1" Color="#F3F4F5" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Face" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#FBFBFC" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Edge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#EAEBED" />
        <GradientStop Offset="1" Color="#DEDFE3" />
    </LinearGradientBrush>

    <!-- パステルの葉緑からミントへ。淡いまま繋ぐ -->
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#8ECB7E" />
        <GradientStop Offset="1" Color="#6FC9AE" />
    </LinearGradientBrush>

</ResourceDictionary>

<!--
    PingWatcher ダークテーマ。黒地。

    地と文字は無彩色のまま、明度だけを反転させたもの。
    色を使うのはアクセント（パステルの水色）と状態バッジだけで、ライトと同じ考え方。

    Palette.xaml と同じキーを同じ意味で定義する。片方にだけキーを足すと
    切り替えた瞬間に色が消えるので、追加は必ず両方へ。自己診断が突き合わせている。

    使い方の約束は Palette.xaml の冒頭コメントを参照（色は DynamicResource で引く、
    コードで TryFindResource の結果をキャッシュしない）。

    **アクセント(水色)と応答あり(ミント)は別系統。** アクセントは無職転生ロキシーの水色。
    
    文字色と地色の組み合わせはすべてコントラスト比 4.5 以上（自己診断が検算する）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ベース。黒に寄せた無彩色 -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#0F0F11" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#17181B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#202226" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#34373D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#EDEEF0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#9A9EA6" po:Freeze="True" />

    <!-- 状態: 応答あり(ミント) -->
    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#0D3D31" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#68EEC2" po:Freeze="True" />

    <!-- 状態: 遅延・警告(アプリコット) -->
    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#432F12" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#FFC65C" po:Freeze="True" />

    <!-- 状態: 不達・エラー(いちご) -->
    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#4D1F2A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#FF8B9E" po:Freeze="True" />

    <!-- 状態: 実行中・情報(ソーダ) -->
    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#13354E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#74C9FF" po:Freeze="True" />

    <!-- 選択・アクセント(パステルの水色。ロキシー)。色を使うのはここだけ -->
    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#1B3050" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#A9D2F0" po:Freeze="True" />

    <!-- グラフ描画用 -->
    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#7FC1EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#1D3019" po:Freeze="True" />

    <!-- サーベイのヒートマップ 6 段(弱→強)。暗い地では一段明るい viridis に寄せる。
         **塗り専用**で、文字の地色には使わないこと(コントラスト検算の対象外) -->
    <SolidColorBrush x:Key="Brush.Heatmap.1" Color="#5C2A80" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Heatmap.2" Color="#5561A8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Heatmap.3" Color="#3E8FA6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Heatmap.4" Color="#35C09A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Heatmap.5" Color="#8EDB62" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Heatmap.6" Color="#FFEF4D" po:Freeze="True" />

    <!-- 細部。ここも無彩色に寄せる -->
    <SolidColorBrush x:Key="Brush.Chip.Edge"    Color="#2A2D33" po:Freeze="True" />
    <!-- つまみは一段明るく(以前の #4A4E56 は面に溶けて見つけにくかった) -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#5C616C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#8A909E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Track" Color="#1E2025" po:Freeze="True" />
    <!-- 行の区切り線。罫線(Border)より一段淡く、詰めた行の境目だけを示す -->
    <SolidColorBrush x:Key="Brush.Row.Line"     Color="#22252B" po:Freeze="True" />

    <!--
        面と枠のグラデーション。影(DropShadowEffect)は使わない。
        一覧は毎秒書き換わるので、効果を挟むと描画が破綻する。
        上辺を明るくした枠で、影の代わりの立体感を出す。
    -->
    <LinearGradientBrush x:Key="Brush.Window.Backdrop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#0F0F11" />
        <GradientStop Offset="1" Color="#141518" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Face" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#1B1D21" />
        <GradientStop Offset="1" Color="#141619" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Edge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#45494F" />
        <GradientStop Offset="1" Color="#2A2D32" />
    </LinearGradientBrush>

    <!-- パステルの水色。ライトと同じ並びにして印象を地続きにする -->
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#A9D2F0" />
        <GradientStop Offset="1" Color="#7FC1EE" />
    </LinearGradientBrush>

</ResourceDictionary>

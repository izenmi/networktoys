<!--
    共通コントロールのスタイル。Palette.xaml のキーに依存するので、
    App.xaml では Palette を先にマージすること。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== カード(各セクションの土台) ===== -->
    <Style x:Key="Card" TargetType="Border">
        <!--
            面はごく薄い縦グラデ、枠は上辺だけ明るいグラデにする。
            影(DropShadowEffect)は使わない。カードの中身は毎秒書き換わるので、
            効果を挟むと中間サーフェス経由の再描画になって重くなる。
            上辺の明るい枠だけで、光が上から当たっているように見える。
        -->
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Face}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="7" />
    </Style>

    <!-- ===== 状態バッジ(地色を敷いてよい唯一の要素) ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Badge.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ===== 見出し ===== -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Heading}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <!-- ===== タブ ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,5" />
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        タブは「押せるもの」と一目で分かる必要がある。
        文字だけを置くと、選択中以外がただのラベルに見えてしまうので、
        非選択時にも面と枠を持たせてボタンの見た目にする。
    -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <!-- タブは 14 枚あるので、文字と余白を詰めて起動幅(740px)でも一列に収める -->
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="6,2"
                            Margin="0,0,2,0">
                        <DockPanel>
                            <!-- 選択中の下線。面の色だけより、どこを見ているかが掴みやすい -->
                            <Rectangle x:Name="Underline" DockPanel.Dock="Bottom"
                                       Height="2" Margin="1,3,1,-2"
                                       RadiusX="1" RadiusY="1"
                                       Visibility="Collapsed"
                                       Fill="{DynamicResource Brush.Accent.Gradient}" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- ホバーを先に、選択を後に書く。順序を入れ替えると選択中もホバー色になる -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Trigger>
                        <!-- Tab キーでの現在地。既定の FocusVisualStyle はテンプレート置換で消えている -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ボタン ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 枠は常に確保しておき、フォーカス時に色だけ変える（寸法が動かない） -->
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1.5"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <!--
                            わずかに縮めると押した手応えが出る。アニメーションは要らない。
                            変形そのものを差し替えているのは、ScaleTransform に名前を付けても
                            TargetName で狙えないため（Freezable は名前解決の対象外）。
                        -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <!--
                            Tab キーで操作する人のための現在地。既定テンプレートを
                            置き換えた時点で標準の FocusVisualStyle は消えているので、
                            テンプレート側で示す必要がある。
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 控えめなボタン(副次操作用) -->
    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- 記号を主体にした小さなボタン(配色の切り替えなど) -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!--
        一覧の列幅を掴むつまみ。見出しの列の境目に重ねて置く。
        見えないが当たり判定は要るので、地は Transparent（null だと拾えない）。
        GridSplitter は使わない — あちらは掴んだ列と隣の列を同時に伸縮するため、
        1 列だけ広げたいときに隣が潰れる不自然な動きになる（ユーザー指摘）。
    -->
    <Style x:Key="ColumnGrip" TargetType="Thumb">
        <Setter Property="Width" Value="7" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Panel.ZIndex" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 入力欄 ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <!-- 複数行 TextBox でも使うので、中央寄せは指定しない -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        伏せ字の入力欄(Meraki の API キー)。
        PasswordBox も既定スタイルがシステム色を入れてくるので、TextBox と同じ枠を
        自前で持つ(暗い配色でここだけ白い箱になるのを避ける)。
        中身の入れ物の名前 PART_ContentHost は TextBox と同じ契約。
    -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ドロップダウン ===== -->
    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{DynamicResource Brush.TextMuted}"
                              StrokeThickness="1.4" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Margin="3,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBox.Toggle}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="9,0,22,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240">
                                    <StackPanel IsItemsHost="True" Margin="0,3" />
                                </ScrollViewer>
                            </Border>
                        </Popup>

                        <!-- Tab キーでの現在地。トグルは Focusable=False なので、本体側に枠を出す -->
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource Radius.Control}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== チェックボックス ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 2.5 6.5 L 5.5 9.5 L 11 3.5"
                                  Stroke="{DynamicResource Brush.Accent.Fg}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Tab キーでの現在地。既定の FocusVisualStyle はテンプレート置換で消えている -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 進捗バー ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Control}">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource Brush.Accent.Gradient}"
                                       RadiusX="2" RadiusY="2" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== 一覧 =====

        WPF の既定の ListBox は Foreground にシステム色（＝黒）を入れる。
        そこから各行の TextBlock へ継承されるため、暗い配色にしても
        宛先名だけが黒いまま残っていた。明示的に上書きしておく。
        ItemsControl と違って ListBox / ListView は既定スタイルを持つので、
        「何も指定しなければ親から継承される」が成り立たない。
    -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        ===== 右クリックメニューとツールチップ =====

        これらも既定ではシステム色で描かれる。暗い配色のときだけ
        白い箱が飛び出してくると目に刺さるので、面と文字を合わせる。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <!--
            テンプレートごと差し替える。既定のテンプレートは左端に
            アイコン用の帯（白い矩形）を敷いており、色を指定しても消えない。
            項目を自前で描いている以上、この帯は使わないので取り除く。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Chip}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <!-- ショートカット表記。無ければ空文字で場所も取らない -->
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="{DynamicResource Size.Caption}"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        メニューバー。既定の Menu/トップレベル MenuItem はシステム色で描かれ、
        暗い配色で白い帯になる(ContextMenu と同じ罠)ので、両方とも自前で持つ。
        ドロップダウンの中の項目は上の暗黙 MenuItem スタイルがそのまま当たる。
        中の項目はすべてフラットにすること(この暗黙テンプレートは子ポップアップ
        =PART_Popup を持たないので、入れ子のサブメニューは開かない)。
    -->
    <!-- メニューの帯。一般的なアプリのように、地色を敷いて本体と切り分ける -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuBarItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- 押せる場所だと分かるよう、面と枠を持たせる。
                         文字だけだとただの見出しに見える(ユーザー指摘) -->
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="10,3" Margin="0,0,3,0">
                        <Grid>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Control}"
                                        Padding="3"
                                        MinWidth="230">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                        <!-- 開いている間は押し込んだ見た目にする(どれを開いたか分かる) -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Fg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Separator.Line" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style TargetType="Separator" BasedOn="{StaticResource Separator.Line}" />

    <!--
        メニューの中の区切り線は、暗黙スタイルではなく専用のキーで引かれる。
        これを置かないと、区切りだけ既定の見た目（白い線）で残る。
    -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource Separator.Line}" />

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
    </Style>

    <!--
        ===== スクロールバー =====
        レール(溝)を敷いて「ここがスクロールできる場所」だと分かるようにする。
        つまみは丸めの棒で、触れると色が濃くなり、掴んでいる間はアクセント色。
    -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Scroll.Thumb}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Scroll.Thumb.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <!-- 14px あればつまみの見え幅が 10px になり、狙って掴める -->
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Background="{DynamicResource Brush.Scroll.Track}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Margin="1" />
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <!-- 増減ボタンは置かない。トラックのクリックでページ送りする -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="14" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

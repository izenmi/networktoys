<!--
    テーマに依らない寸法と書体。

    ここに置く値は「明るさを変えても変わらないもの」に限る。色は Palette 側。
    両テーマに同じ値を書くとどちらかを直し忘れるので、色以外は必ずこちらへ。

    角は四角(角丸なし)。ユーザーの好みで 2026-08-15 に角丸をやめた。
    キーは残してある — 角を触るときは必ずここを通し、数値を直書きしないこと。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 書体 -->
    <!-- 埋め込みの Noto Sans JP を最優先。exe に同梱してあるので端末に無くても効く。
         #以降は OTF 内部の family 名(Noto Sans JP)。念のため未解決時は游ゴシック系へ -->
    <FontFamily x:Key="Font.Ui">./Resources/Fonts/#Noto Sans JP, Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <!-- 等幅。日本語の受け皿に MS ゴシックを置くとビットマップ調で古臭くなるので、
         BIZ UD が無い環境では UI と同じ游ゴシック系に落とす(全角は幅が揃うので実害がない) -->
    <FontFamily x:Key="Font.Mono">Consolas, BIZ UDGothic, Yu Gothic UI, Meiryo UI</FontFamily>

    <!-- 角は四角。丸めたくなったらここを変える(直書き禁止) -->
    <CornerRadius x:Key="Radius.Card">0</CornerRadius>
    <CornerRadius x:Key="Radius.Control">0</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">0</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">0</CornerRadius>

    <!-- 文字の大きさ -->
    <sys:Double x:Key="Size.Title">15</sys:Double>
    <sys:Double x:Key="Size.Heading">14</sys:Double>
    <sys:Double x:Key="Size.Body">12</sys:Double>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Micro">9</sys:Double>

    <!-- 一覧の行の高さ。一覧で見える数を優先して 18 まで詰めた(2026-08-15 ユーザー指示)。
         行ピッチは 18 + 区切り線 1px = 19px -->
    <sys:Double x:Key="Size.RowHeight">18</sys:Double>

</ResourceDictionary>

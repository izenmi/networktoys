<!--
    テーマに依らない寸法と書体。

    ここに置く値は「明るさを変えても変わらないもの」に限る。色は Palette 側。
    両テーマに同じ値を書くとどちらかを直し忘れるので、色以外は必ずこちらへ。

    角丸は 4 段階だけにしてある。以前は 4/5/6/7/8/9 が混在していて、
    並べたときに揃って見えなかった。迷ったら Radius.Control を使うこと。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 書体 -->
    <FontFamily x:Key="Font.Ui">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, BIZ UDGothic, MS Gothic</FontFamily>

    <!--
        角丸。キャンディらしい柔らかさを出すため、全体に一段丸めてある。
        ただし行の中の小片(Chip)まで丸くすると、敷き詰めたときに粒がぼやけて
        一覧性が落ちるので、そこだけは控えめにしている。
    -->
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Control">9</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">7</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">5</CornerRadius>

    <!-- 文字の大きさ -->
    <sys:Double x:Key="Size.Title">15</sys:Double>
    <sys:Double x:Key="Size.Heading">14</sys:Double>
    <sys:Double x:Key="Size.Body">12</sys:Double>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Micro">9</sys:Double>

    <!-- 一覧の行の高さ。詰めるほど一覧性が上がるが、日本語が窮屈になるので 22 を下限にしている -->
    <sys:Double x:Key="Size.RowHeight">22</sys:Double>

</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PingWatcher</AssemblyName>
    <RootNamespace>PingWatcher.App</RootNamespace>
    <Version>0.1.0</Version>

    <!-- Core と同じく警告をエラーにする。CI が唯一のコンパイラなので、
         いちばん検証しづらい WPF 側こそ警告止まりにしない -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- exe のプロパティ画面に出る情報。未署名の exe を配る以上、空欄にしない -->
    <Product>PingWatcher</Product>
    <Company>izenmi</Company>
    <Copyright>© izenmi</Copyright>
    <Description>ネットワーク診断ツール</Description>

    <!-- 管理者権限を要求しない / 高DPI対応を宣言する -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe に埋め込むアイコン。エクスプローラ・タスクバー・タイトルバーが使う。
         元の SVG から tools/icon/build_icon.sh で焼いたもの。手で差し替えないこと。 -->
    <ApplicationIcon>Resources/AppIcon.ico</ApplicationIcon>

    <!-- PDB を exe に埋め込む。配布物が 1 ファイルで済み、例外の行番号も残る -->
    <DebugType>embedded</DebugType>

    <!-- 起動速度・省メモリのための設定。publish 固有の設定(SelfContained /
         PublishSingleFile / PublishReadyToRun)は CI のコマンドラインで渡す。
         Phase 0 で 3 構成を実測して採用形を決めるため、ここには書かない。 -->
    <!-- InvariantGlobalization は WPF では使えない。true にすると ICU が同梱されず、
         MS.Internal.FontCache.MajorLanguages の型初期化に失敗して最初の TextBlock を
         測った瞬間に落ちる(CI で実測。dotnet publish は通り、ウィンドウ表示時に死ぬ)。
         ICU の分だけ大きくなるが、日本語の日付書式が正しく出せる利点もある。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WPF はトリミング非対応。true にすると NETSDK1168 でビルドが失敗する。
         PublishAot も同様に使えない。単一 exe のサイズは削れないものと割り切り、
         「軽量」はファイルサイズではなく起動時間とメモリで満たす。 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- composite R2R はサイズが激増するので使わない -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <!-- IEEE の MA-L 登録簿から作った OUI テーブル。初回の MAC 解決時にだけ展開する。
         更新は tools/oui/build_oui.py を手で実行する。 -->
    <EmbeddedResource Include="Resources/oui.tsv.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Net.Dns は A/AAAA/PTR しか引けず、問い合わせ先サーバも指定できない。
         「社内 DNS では引けるが外部 DNS では引けない」の切り分けに必要なので使う。
         ネイティブ依存がないので単一ファイル発行でも安全。 -->
    <PackageReference Include="DnsClient" Version="1.8.0" />

    <!-- Native Wifi API のマネージドラッパ。依存パッケージなし。
         これ以外の選択肢は wlanapi の自前 P/Invoke になる。 -->
    <PackageReference Include="ManagedNativeWifi" Version="3.0.2" />

    <!-- SFTP サーバのための SSH 実装。SSH を自前で書くのは非現実的（暗号の
         正しさが命）なので、これだけは依存を許容する。MIT / net8.0 /
         ECDH nistp256-521・aes-gcm・hmac-sha2・SFTPv3。Microsoft の
         dev-tunnels-ssh の元コード。SFTP サブシステム実装はライブラリに
         含まれないので Vendor/FxSsh/SftpService.cs に取り込んである。 -->
    <PackageReference Include="FxSsh" Version="1.4.0" />

    <!-- ipconfig の出力(CP932)の読み取りに使う System.Text.Encoding.CodePages は
         .NET 10 ではフレームワークに同梱されており、明示参照すると NU1510 になる -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PingWatcher.Core/PingWatcher.Core.csproj" />
  </ItemGroup>

</Project>

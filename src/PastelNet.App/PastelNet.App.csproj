<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PastelNet</AssemblyName>
    <RootNamespace>PastelNet.App</RootNamespace>
    <Version>0.1.0</Version>

    <!-- 管理者権限を要求しない / 高DPI対応を宣言する -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- PDB を exe に埋め込む。配布物が 1 ファイルで済み、例外の行番号も残る -->
    <DebugType>embedded</DebugType>

    <!-- 起動速度・省メモリのための設定。publish 固有の設定(SelfContained /
         PublishSingleFile / PublishReadyToRun)は CI のコマンドラインで渡す。
         Phase 0 で 3 構成を実測して採用形を決めるため、ここには書かない。 -->
    <!-- InvariantGlobalization は WPF では使えない。true にすると ICU が同梱されず、
         MS.Internal.FontCache.MajorLanguages の型初期化に失敗して最初の TextBlock を
         測った瞬間に落ちる(CI で実測。dotnet publish は通り、ウィンドウ表示時に死ぬ)。
         ICU の分だけ大きくなるが、日本語の日付書式が正しく出せる利点もある。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WPF はトリミング非対応。true にすると NETSDK1168 でビルドが失敗する。
         PublishAot も同様に使えない。単一 exe のサイズは削れないものと割り切り、
         「軽量」はファイルサイズではなく起動時間とメモリで満たす。 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- composite R2R はサイズが激増するので使わない -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <!-- IEEE の MA-L 登録簿から作った OUI テーブル。初回の MAC 解決時にだけ展開する。
         更新は tools/oui/build_oui.py を手で実行する。 -->
    <EmbeddedResource Include="Resources/oui.tsv.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Net.Dns は A/AAAA/PTR しか引けず、問い合わせ先サーバも指定できない。
         「社内 DNS では引けるが外部 DNS では引けない」の切り分けに必要なので使う。
         ネイティブ依存がないので単一ファイル発行でも安全。 -->
    <PackageReference Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PastelNet.Core/PastelNet.Core.csproj" />
  </ItemGroup>

</Project>

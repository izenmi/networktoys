<Window x:Class="PastelNet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PastelNet.App.Controls"
        Title="PastelNet"
        Width="1140" Height="720"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 一覧 1 行。列幅はヘッダ側と合わせること -->
        <DataTemplate x:Key="TargetRowTemplate">
            <Grid Height="{DynamicResource Size.RowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="158" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge"
                        Grid.Column="0"
                        Style="{StaticResource Badge}"
                        Background="{DynamicResource Brush.Info.Bg}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText"
                               Style="{StaticResource Badge.Text}"
                               Foreground="{DynamicResource Brush.Info.Fg}"
                               Text="◌ 待機" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Host}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2" Text="{Binding Address}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="3" Text="{Binding LatestRtt}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Column="4" Text="{Binding AverageRtt}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Column="5" Text="{Binding Loss}"
                           Style="{StaticResource Mono}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <controls:Sparkline Grid.Column="6" Source="{Binding}" Margin="8,3,8,3" />

                <TextBlock Grid.Column="7" Text="{Binding Comment}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Ok.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Ok.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="● 応答" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Slow">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="▲ 遅延" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="✕ 不達" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Refused">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Warn.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warn.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="⊘ 拒否" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unresolved">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Bg}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error.Fg}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="? 名前" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 行コンテナ。選択の見た目だけ差し替え、既定の青い選択色は使わない -->
        <Style x:Key="TargetRowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10,8,10,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ヘッダ ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
            <Border Background="{DynamicResource Brush.Accent.Bg}"
                    CornerRadius="6" Width="22" Height="22"
                    VerticalAlignment="Center">
                <TextBlock Text="◔" FontSize="13"
                           Foreground="{DynamicResource Brush.Accent.Fg}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="PastelNet" FontSize="15" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="ぜんぶ同時に測る"
                       Style="{StaticResource Caption}"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ===== 本体 ===== -->
        <TabControl Grid.Row="1">

            <!-- ===== 監視 ===== -->
            <TabItem Header="監視">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <!-- 操作列 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding RunButtonLabel}"
                                    Command="{Binding StartCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="停止"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Margin="0,0,6,0" />
                            <Button Content="履歴を消去"
                                    Command="{Binding ClearHistoryCommand}"
                                    Style="{StaticResource Button.Subtle}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 一覧のヘッダ。列幅は TargetRowTemplate と合わせる -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" MinWidth="100" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="状態"     Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="宛先"     Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="IP"       Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="RTT"      Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="平均"     Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="ロス"     Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="推移"     Style="{StaticResource Caption}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="7" Text="備考"     Style="{StaticResource Caption}" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{DynamicResource Brush.Border}" Margin="0,0,0,2" />

                        <!-- 一覧本体。仮想化を効かせるため行高は固定にしている -->
                        <ListBox ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow}"
                                 ItemTemplate="{StaticResource TargetRowTemplate}"
                                 ItemContainerStyle="{StaticResource TargetRowContainer}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== 宛先(EXPing と同じ書き方でまとめて編集する) ===== -->
            <TabItem Header="宛先">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="宛先リスト" />

                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    1 行に 1 宛先。アドレスの後ろに<Run FontWeight="SemiBold">半角スペース</Run>を空けると、そこから行末までが備考になります。
                                    行頭が <Run FontWeight="SemiBold">#</Run> <Run FontWeight="SemiBold">;</Run> <Run FontWeight="SemiBold">'</Run> 全角スペース の行は注釈として読み飛ばします。
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    範囲でまとめて書けます（EXPing にはない拡張）:
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.10-20</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.1-192.168.1.50</Run> ／
                                    <Run FontFamily="{DynamicResource Font.Mono}">192.168.1.0/24</Run>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    末尾に <Run FontFamily="{DynamicResource Font.Mono}">:ポート</Run> を付けると、ICMP ではなく TCP 接続で測ります（例
                                    <Run FontFamily="{DynamicResource Font.Mono}">example.jp:443</Run>）。ping が塞がれている相手の確認に使えます。
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="一覧に反映" Command="{Binding ApplyListCommand}" Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Text="反映すると測定を停止し、履歴を作り直します。" />
                            </StackPanel>
                            <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBox Text="{Binding TargetListText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== スキャン ===== -->
            <TabItem Header="スキャン">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="IP スキャン" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="範囲を指定してサブネットを掃き、応答したホストの MAC・ベンダー名・開放ポートを一覧にします。Phase 3 で実装します。" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== DNS ===== -->
            <TabItem Header="DNS">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="DNS テスト" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="同じ名前を複数の DNS サーバへ同時に問い合わせ、結果を横並びで比較します。A / AAAA / CNAME / MX / NS / TXT / SOA / SRV / PTR に対応。Phase 2 で実装します。" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== 経路 ===== -->
            <TabItem Header="経路">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="traceroute" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="TTL 1〜30 を少しずつずらして並列に投げるので、経路全体が一度に埋まります。逆引きは後追いで解決し、判明した行から順に差し込みます。Phase 2 で実装します。" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== 無線 ===== -->
            <TabItem Header="無線">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="無線 LAN" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="接続中 AP の詳細、RSSI の時系列、周辺 AP のチャンネル混雑を表示します。Windows 11 24H2 以降は位置情報の許可が必要なため、この画面を開いたときに初めてスキャンします。Phase 4 で実装します。" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== 記録 ===== -->
            <TabItem Header="記録">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="記録とレポート" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="測定結果はセッション単位で保存し、グラフ入りの HTML と CSV に書き出せます。HTML は 1 ファイル完結なのでそのままメールに添付できます。Phase 6 で実装します。" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===== ステータスバー ===== -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,4"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="接続: " Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding InterfaceText}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                <TextBlock Text="／" Style="{StaticResource Caption}" Margin="8,0" />
                <TextBlock Text="IP: " Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding LocalAddressText}" Style="{StaticResource Mono}" />
                <TextBlock Text="／" Style="{StaticResource Caption}" Margin="8,0" />
                <TextBlock Text="GW: " Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding GatewayText}" Style="{StaticResource Mono}" />
                <TextBlock Text="／" Style="{StaticResource Caption}" Margin="8,0" />
                <TextBlock Text="DNS: " Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding DnsText}" Style="{StaticResource Mono}"
                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

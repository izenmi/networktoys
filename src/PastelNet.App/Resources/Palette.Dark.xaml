<!--
    PastelNet ダークテーマ。既定の配色。

    Palette.xaml と同じキーを同じ意味で定義する。片方にだけキーを足すと
    切り替えた瞬間に色が消えるので、追加は必ず両方へ。自己診断が突き合わせている。

    使い方の約束は Palette.xaml の冒頭コメントを参照（色は DynamicResource で引く、
    コードで TryFindResource の結果をキャッシュしない）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <SolidColorBrush x:Key="Brush.Background"   Color="#2B2733" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#363042" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#3E3750" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#4A4259" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#EDE7F3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#A79FB8" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#2F5D4A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#8FE3C0" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#5E4526" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#FFD08A" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#5E3230" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#FFA8A3" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#234C63" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#9AD5F5" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#3D4270" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#B9C0F0" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#7FB8D9" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#2C4457" po:Freeze="True" />

</ResourceDictionary>

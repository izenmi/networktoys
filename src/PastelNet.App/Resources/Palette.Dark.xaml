<!--
    PastelNet ダークテーマ。既定の配色。

    深い紺の地に、彩度を保ったパステルを光らせる。監視画面として長時間見るので、
    地は黒ではなく青みを残して沈ませ、状態の色だけが浮き上がるようにしている。

    Palette.xaml と同じキーを同じ意味で定義する。片方にだけキーを足すと
    切り替えた瞬間に色が消えるので、追加は必ず両方へ。自己診断が突き合わせている。

    使い方の約束は Palette.xaml の冒頭コメントを参照（色は DynamicResource で引く、
    コードで TryFindResource の結果をキャッシュしない）。

    文字色と地色の組み合わせはすべてコントラスト比 4.5 以上。
    数字は自己診断が毎回検算するので、色をいじったら CI の結果を見ること。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ベース(深い紺) -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#0E1424" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#171E33" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#1F2740" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#303C60" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#E8ECF8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#9AA7CC" po:Freeze="True" />

    <!-- 状態: 応答あり(ミント) -->
    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#1B4A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#6FE7B4" po:Freeze="True" />

    <!-- 状態: 遅延・警告(アンバー) -->
    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#54401F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#FFC97A" po:Freeze="True" />

    <!-- 状態: 不達・エラー(コーラル) -->
    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#5C2C30" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#FF9E97" po:Freeze="True" />

    <!-- 状態: 実行中・情報(スカイ) -->
    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#1B4059" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#7CCDF4" po:Freeze="True" />

    <!-- 選択・アクセント(ペリウィンクル) -->
    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#333C76" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#A7B2FF" po:Freeze="True" />

    <!-- グラフ描画用 -->
    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#6FC3F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#1B3A52" po:Freeze="True" />

    <!-- 細部。枠と面をわずかに変えるだけで、平坦な暗い画面に奥行きが出る -->
    <SolidColorBrush x:Key="Brush.Chip.Edge"    Color="#2C3A5E" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#4C5878" po:Freeze="True" />

    <!--
        面と枠のグラデーション。影(DropShadowEffect)は使わない。
        一覧は毎秒書き換わるので、効果を挟むと描画が破綻する。
        上辺を明るくした枠で、影の代わりの立体感を出す。
    -->
    <LinearGradientBrush x:Key="Brush.Window.Backdrop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#0E1424" />
        <GradientStop Offset="1" Color="#131A30" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Face" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#1A2238" />
        <GradientStop Offset="1" Color="#141B2E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Edge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#3A4668" />
        <GradientStop Offset="1" Color="#232C4A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#A7B2FF" />
        <GradientStop Offset="1" Color="#7CCDF4" />
    </LinearGradientBrush>

</ResourceDictionary>

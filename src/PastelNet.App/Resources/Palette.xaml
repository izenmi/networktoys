<!--
    PastelNet ライトテーマの配色。

    使い方の約束: 地色(*.Bg)と文字色(*.Fg)は必ずペアで使う。
    パステルの地に淡い文字を置くと読めなくなるため、組み合わせを崩さないこと。
    地色を敷くのは状態バッジだけにし、RTT などの数値は文字色のみで表現する。

    ブラシは po:Freeze="True" で凍結している。数百行を描画するので効く。

    テーマ切替のための約束:
    ・この辞書は ThemeManager が丸ごと差し替える。**色は必ず DynamicResource で引くこと。**
      StaticResource で引いた箇所は切り替えても古い色のまま残る。
    ・コードから TryFindResource した結果を static に**キャッシュしない**。
      Sparkline で実際にやってしまい、切替に追随しない不具合になった。
    ・Palette.Dark.xaml と**同じキーを過不足なく**定義する。ずれは自己診断が検出する。
    ・凍結ブラシは Color をアニメーションできない。演出は Opacity 側で行う。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ベース -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#F8F5F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#F0EBF8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#E6DFEF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text"         Color="#332C46" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#665E82" po:Freeze="True" />

    <!-- 状態: 応答あり(ミント) -->
    <SolidColorBrush x:Key="Brush.Ok.Bg"        Color="#B4EDD6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ok.Fg"        Color="#126343" po:Freeze="True" />

    <!-- 状態: 遅延・警告(ピーチ) -->
    <SolidColorBrush x:Key="Brush.Warn.Bg"      Color="#FFDCA8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warn.Fg"      Color="#84490B" po:Freeze="True" />

    <!-- 状態: 不達・エラー(ローズ) -->
    <SolidColorBrush x:Key="Brush.Error.Bg"     Color="#FFC8C4" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Fg"     Color="#A32F29" po:Freeze="True" />

    <!-- 状態: 実行中・情報(スカイ) -->
    <SolidColorBrush x:Key="Brush.Info.Bg"      Color="#BCE5FB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Info.Fg"      Color="#0F5678" po:Freeze="True" />

    <!-- 選択・アクセント(ラベンダー) -->
    <SolidColorBrush x:Key="Brush.Accent.Bg"    Color="#C3CCF5" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Fg"    Color="#333E8C" po:Freeze="True" />

    <!-- グラフ描画用の淡色(スパークラインの塗り) -->
    <SolidColorBrush x:Key="Brush.Chart.Line"   Color="#4E92C4" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chart.Fill"   Color="#DDEEF9" po:Freeze="True" />

    <!-- 細部。ダークと同じキーを揃える -->
    <SolidColorBrush x:Key="Brush.Chip.Edge"    Color="#E7E1F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#C7BFD8" po:Freeze="True" />

    <!--
        面と枠のグラデーション。影(DropShadowEffect)は使わない。
        一覧は毎秒書き換わるので、効果を挟むと描画が破綻する。
        上辺を明るくした枠で、影の代わりの立体感を出す。
    -->
    <LinearGradientBrush x:Key="Brush.Window.Backdrop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FAF7F2" />
        <GradientStop Offset="1" Color="#F3EEE7" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Face" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#FDFBF9" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card.Edge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#EAE4F1" />
        <GradientStop Offset="1" Color="#E2DAEC" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#333E8C" />
        <GradientStop Offset="1" Color="#0F5678" />
    </LinearGradientBrush>

</ResourceDictionary>
